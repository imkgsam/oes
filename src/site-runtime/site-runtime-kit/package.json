{
  "name": "@oes/site-runtime-kit",
  "version": "0.1.0",
  "description": "OES external site runtime SDK and lightweight runtime framework.",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "NODE_OPTIONS=--no-warnings=ExperimentalWarning jest --config jest.config.js --runInBand",
    "test:unit": "NODE_OPTIONS=--no-warnings=ExperimentalWarning jest --config jest.config.js --runInBand test/unit",
    "test:store": "NODE_OPTIONS=--no-warnings=ExperimentalWarning jest --config jest.config.js --runInBand test/store",
    "test:integration": "NODE_OPTIONS=--no-warnings=ExperimentalWarning jest --config jest.config.js --runInBand test/integration",
    "test:e2e": "NODE_OPTIONS=--no-warnings=ExperimentalWarning jest --config jest.config.js --runInBand test/e2e",
    "smoke:local-runtime": "NODE_OPTIONS=--no-warnings=ExperimentalWarning ts-node --project tsconfig.spec.json scripts/local-runtime-smoke.ts",
    "clear:build": "rimraf dist && rimraf tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "jest": "^29.7.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
