{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@oes/common/generated/site_service": ["../../common/dist/generated/index.site_service.js"],
      "@oes/common/*": ["../../common/dist/*"],
      "@oes/site-runtime-kit": ["../site-runtime-kit/src/index.ts"]
    },
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"]
  },
  "include": [
    "scripts/locale-governance-acceptance-harness.ts",
    "scripts/locale-governance-gateway-harness.ts",
    "scripts/verify-locale-governance-acceptance.ts",
    "tests/locale-governance-acceptance-harness.test.ts",
    "runtime/src/site-capability-manifest.ts"
  ]
}
