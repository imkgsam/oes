# Meilong Ceramics Site root environment example.
# Copy values into runtime/.env.local and storefront/.env.local as needed.
# Do not put real credentials or secrets in this file.

# Shared public site identity. Keep canonical and sitemap URLs production-shaped.
SITE_PUBLIC_BASE_URL=https://meilong-ceramics.com
SITE_DEFAULT_LOCALE=en-US
SITE_ACTIVE_LOCALES=en-US
SITE_NAME=Meilong Ceramics

# Runtime-only secret placeholder for OES Live Sync Mode.
# Use a real value only in runtime/.env.local or a secret manager.
OES_SITE_CREDENTIAL=oes_site_cred_v1.<base64url-json-from-oes-site-management>

# Seed Preview Mode only. This seeds local published data and does not prove OES live sync.
SITE_MEILONG_SEED_PUBLISHED_DATA=true

# Local process ports.
SITE_RUNTIME_HOST=127.0.0.1
SITE_RUNTIME_PORT=4301
NUXT_HOST=127.0.0.1
NUXT_PORT=4300
