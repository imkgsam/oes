generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CrmCustomerStatus {
  ACTIVE_CUSTOMER
  BLOCKED
  ARCHIVED
}

enum CrmCustomerPartyBindingStatus {
  ACTIVE_PRIMARY
}

model CrmSequenceCounter {
  tenantId               String   @id @db.VarChar(128)
  nextCustomerAccountNo  Int      @default(1)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model CustomerAccount {
  id                String               @id @db.Uuid
  customerAccountNo String               @unique @db.VarChar(64)
  tenantId          String               @db.VarChar(128)
  displayName       String               @db.VarChar(255)
  status            CrmCustomerStatus
  customerCategory  String?              @db.VarChar(128)
  tags              Json
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  primaryBinding    CustomerPartyBinding?
  contacts          CustomerContact[]
  addresses         CustomerAddress[]

  @@index([tenantId, status, customerAccountNo])
  @@index([tenantId, displayName])
}

model CustomerPartyBinding {
  id                String                        @id @db.Uuid
  tenantId          String                        @db.VarChar(128)
  customerAccountId String                        @unique @db.Uuid
  tenantPartyId     String                        @db.VarChar(128)
  bindingStatus     CrmCustomerPartyBindingStatus
  partyDisplayName  String?                       @db.VarChar(255)
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([tenantId, tenantPartyId])
  @@index([tenantId, bindingStatus])
  @@unique([tenantId, tenantPartyId])
}

model CustomerContact {
  id                String          @id @db.Uuid
  tenantId          String          @db.VarChar(128)
  customerAccountId String          @db.Uuid
  displayName       String          @db.VarChar(255)
  roleTitle         String?         @db.VarChar(255)
  email             String?         @db.VarChar(255)
  phone             String?         @db.VarChar(64)
  isPrimaryContact  Boolean
  isActive          Boolean
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerAccountId, displayName])
}

model CustomerAddress {
  id                String          @id @db.Uuid
  tenantId          String          @db.VarChar(128)
  customerAccountId String          @db.Uuid
  label             String          @db.VarChar(128)
  countryCode       String          @db.VarChar(32)
  region            String?         @db.VarChar(128)
  locality          String?         @db.VarChar(128)
  addressLine1      String          @db.VarChar(255)
  addressLine2      String?         @db.VarChar(255)
  postalCode        String?         @db.VarChar(64)
  isPrimaryAddress  Boolean
  isActive          Boolean
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerAccountId, label])
}

model CrmAuditEnvelope {
  id           String   @id
  service      String
  module       String
  eventType    String
  occurredAt   DateTime
  result       String
  operatorId   String?
  operatorType String
  tenantId     String?
  orgId        String?
  traceId      String?
  resourceType String
  resourceId   String?
  details      Json
  createdAt    DateTime @default(now())

  @@index([service, module, eventType, occurredAt])
  @@index([tenantId, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
}
