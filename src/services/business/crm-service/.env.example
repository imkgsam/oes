SERVICE_NAME="crm-service"
MODULE_NAME="crm-service"
GRPC_LISTEN_HOST="0.0.0.0"
GRPC_LISTEN_PORT="50060"
SERVICE_REGISTRY_PORT="50060"

# Recommended local isolation: prefer a dedicated database, e.g. postgres://user:pass@127.0.0.1:5432/crmdb
# If your local PostgreSQL is shared, use a dedicated schema, e.g. postgres://user:pass@127.0.0.1:5432/oes?schema=crm_service
DATABASE_URL="postgres://imkgsam:imkgsam@127.0.0.1:5432/crmdb"

# Downstream party-service lookup used by BindCustomerAccountToTenantParty.
GRPC_SERVICE_PARTY_URL="127.0.0.1:50053"
