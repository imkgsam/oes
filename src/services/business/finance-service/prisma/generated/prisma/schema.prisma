generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FinancialAccountType {
  BANK
  CASH
  WECHAT
  ALIPAY
  PAYPAL
  STRIPE
  OTHER_PSP
}

enum FinancialAccountStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum AccountTransactionDirection {
  INFLOW
  OUTFLOW
}

enum AccountTransactionSourceType {
  MANUAL
  CSV_IMPORT
  FUTURE_API
}

enum AccountTransactionStatus {
  DRAFT
  CONFIRMED
  VOIDED
}

enum AccountTransactionAllocationStatus {
  UNALLOCATED
  PARTIALLY_ALLOCATED
  FULLY_ALLOCATED
}

enum CustomerFinancialAccountVerifiedStatus {
  UNVERIFIED
  VERIFIED
}

enum ReceivableScheduleStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
  ON_HOLD
}

enum ReceivableScheduleLineStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
  OVERDUE
}

enum FinanceReleaseSignalStatus {
  RELEASED
  HELD
  REVIEW_REQUIRED
}

model FinanceSequenceCounter {
  tenantId                 String   @id @db.VarChar(128)
  nextFinancialAccountNo   Int      @default(1)
  nextReceivableScheduleNo Int      @default(1)
  nextPayableScheduleNo    Int      @default(1)
  nextPaymentRequestNo     Int      @default(1)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model FinancialAccount {
  id                      String                            @id @db.Uuid
  accountNo               String                            @db.VarChar(64)
  tenantId                String                            @db.VarChar(128)
  orgId                   String?                           @db.VarChar(128)
  accountType             FinancialAccountType
  accountName             String                            @db.VarChar(255)
  currencyCode            String                            @db.VarChar(16)
  institutionName         String?                           @db.VarChar(255)
  accountIdentifierMasked String                            @db.VarChar(255)
  status                  FinancialAccountStatus
  lastTransactionAt       DateTime?
  createdAt               DateTime                          @default(now())
  updatedAt               DateTime                          @updatedAt
  balanceSnapshots        FinancialAccountBalanceSnapshot[]
  transactions            AccountTransaction[]
  importBatches           AccountTransactionImportBatch[]

  @@unique([tenantId, accountNo])
  @@index([tenantId, accountNo])
  @@index([tenantId, status, accountType])
}

model FinancialAccountBalanceSnapshot {
  id                 String   @id @db.Uuid
  tenantId           String   @db.VarChar(128)
  financialAccountId String   @db.Uuid
  snapshotBalance    Decimal  @db.Decimal(18, 6)
  snapshotAt         DateTime
  createdAt          DateTime @default(now())

  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)

  @@index([tenantId, financialAccountId, snapshotAt])
}

model AccountTransactionImportBatch {
  id                   String               @id @db.Uuid
  tenantId             String               @db.VarChar(128)
  financialAccountId   String               @db.Uuid
  sourceType           String               @db.VarChar(64)
  sourceBatchReference String?              @db.VarChar(255)
  fileAssetId          String?              @db.VarChar(128)
  attachmentRef        String?              @db.VarChar(255)
  importedBy           String               @db.VarChar(128)
  totalRows            Int
  acceptedCount        Int
  duplicateCount       Int
  failedCount          Int
  createdAt            DateTime             @default(now())
  transactions         AccountTransaction[]

  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)

  @@index([tenantId, financialAccountId, createdAt])
}

model AccountTransaction {
  id                          String                             @id @db.Uuid
  tenantId                    String                             @db.VarChar(128)
  orgId                       String?                            @db.VarChar(128)
  financialAccountId          String                             @db.Uuid
  importBatchId               String?                            @db.Uuid
  direction                   AccountTransactionDirection
  amount                      Decimal                            @db.Decimal(18, 6)
  currencyCode                String                             @db.VarChar(16)
  transactionTime             DateTime
  valueDate                   String?                            @db.VarChar(32)
  sourceType                  AccountTransactionSourceType
  status                      AccountTransactionStatus
  externalReference           String?                            @db.VarChar(255)
  counterpartyName            String?                            @db.VarChar(255)
  counterpartyAccountSnapshot String?                            @db.VarChar(255)
  memo                        String?                            @db.VarChar(1000)
  paymentExecutionId          String?                            @db.VarChar(128)
  allocationStatus            AccountTransactionAllocationStatus
  allocatedAmount             Decimal                            @db.Decimal(18, 6)
  unallocatedAmount           Decimal                            @db.Decimal(18, 6)
  fileAssetId                 String?                            @db.VarChar(128)
  attachmentRef               String?                            @db.VarChar(255)
  dedupeKey                   String                             @db.VarChar(512)
  createdAt                   DateTime                           @default(now())
  updatedAt                   DateTime                           @updatedAt
  allocations                 PaymentAllocation[]

  financialAccount FinancialAccount               @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)
  importBatch      AccountTransactionImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([tenantId, financialAccountId, dedupeKey])
  @@index([tenantId, financialAccountId, transactionTime])
  @@index([tenantId, externalReference])
}

model CustomerFinancialAccount {
  id                      String                                 @id @db.Uuid
  tenantId                String                                 @db.VarChar(128)
  customerTenantPartyId   String                                 @db.VarChar(128)
  accountHolderName       String                                 @db.VarChar(255)
  accountProviderType     String                                 @db.VarChar(64)
  accountIdentifierMasked String                                 @db.VarChar(255)
  currencyCode            String?                                @db.VarChar(16)
  isDefault               Boolean
  verifiedStatus          CustomerFinancialAccountVerifiedStatus
  createdAt               DateTime                               @default(now())
  updatedAt               DateTime                               @updatedAt

  @@index([tenantId, customerTenantPartyId, isDefault])
}

model SupplierFinancialAccount {
  id                      String   @id @db.Uuid
  tenantId                String   @db.VarChar(128)
  supplierTenantPartyId   String   @db.VarChar(128)
  accountHolderName       String   @db.VarChar(255)
  accountProviderType     String   @db.VarChar(64)
  accountIdentifierMasked String   @db.VarChar(255)
  currencyCode            String?  @db.VarChar(16)
  isDefault               Boolean
  verifiedStatus          String   @db.VarChar(64)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([tenantId, supplierTenantPartyId, isDefault])
}

model ReceivableSchedule {
  id                        String                   @id @db.Uuid
  scheduleNo                String                   @db.VarChar(64)
  tenantId                  String                   @db.VarChar(128)
  orgId                     String?                  @db.VarChar(128)
  sourceSalesOrderId        String                   @db.VarChar(128)
  customerTenantPartyId     String                   @db.VarChar(128)
  customerSnapshot          String                   @db.VarChar(255)
  currencyCode              String                   @db.VarChar(16)
  status                    ReceivableScheduleStatus
  totalScheduledAmount      Decimal                  @db.Decimal(18, 6)
  totalAllocatedAmount      Decimal                  @db.Decimal(18, 6)
  outstandingAmount         Decimal                  @db.Decimal(18, 6)
  salesExchangeRateSnapshot String?                  @db.VarChar(255)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  lines                     ReceivableScheduleLine[]

  @@unique([tenantId, scheduleNo])
  @@index([tenantId, sourceSalesOrderId, status])
  @@index([tenantId, customerTenantPartyId, scheduleNo])
}

model PayableSchedule {
  id                           String                @id @db.Uuid
  scheduleNo                   String                @db.VarChar(64)
  tenantId                     String                @db.VarChar(128)
  orgId                        String?               @db.VarChar(128)
  sourceType                   String                @db.VarChar(64)
  sourcePurchaseOrderId        String                @db.VarChar(128)
  sourcePurchaseOrderNo        String?               @db.VarChar(128)
  procurementSnapshotReference String?               @db.VarChar(255)
  supplierTenantPartyId        String                @db.VarChar(128)
  supplierSnapshot             String                @db.VarChar(255)
  currencyCode                 String                @db.VarChar(16)
  status                       String                @db.VarChar(64)
  totalScheduledAmount         Decimal               @db.Decimal(18, 6)
  totalRequestedAmount         Decimal               @db.Decimal(18, 6)
  totalExecutedAmount          Decimal               @db.Decimal(18, 6)
  totalAllocatedAmount         Decimal               @db.Decimal(18, 6)
  outstandingAmount            Decimal               @db.Decimal(18, 6)
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt
  lines                        PayableScheduleLine[]

  @@unique([tenantId, scheduleNo])
  @@index([tenantId, sourcePurchaseOrderId, status])
  @@index([tenantId, supplierTenantPartyId, scheduleNo])
}

model PayableScheduleLine {
  id                        String   @id @db.Uuid
  tenantId                  String   @db.VarChar(128)
  payableScheduleId         String   @db.Uuid
  lineNo                    Int
  lineType                  String   @db.VarChar(64)
  sourceRef                 String   @db.VarChar(255)
  dueDate                   String   @db.VarChar(32)
  scheduledAmount           Decimal  @db.Decimal(18, 6)
  requestedAmount           Decimal  @db.Decimal(18, 6)
  executedAmount            Decimal  @db.Decimal(18, 6)
  allocatedAmount           Decimal  @db.Decimal(18, 6)
  outstandingAmount         Decimal  @db.Decimal(18, 6)
  status                    String   @db.VarChar(64)
  requestGovernanceStatus   String   @db.VarChar(64)
  sourcePurchaseOrderLineId String?  @db.VarChar(128)
  supersedesSourceRef       String?  @db.VarChar(255)
  memo                      String?  @db.VarChar(1000)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  payableSchedule PayableSchedule @relation(fields: [payableScheduleId], references: [id], onDelete: Cascade)

  @@unique([payableScheduleId, lineNo])
  @@index([tenantId, payableScheduleId, dueDate])
  @@index([tenantId, sourceRef])
}

model ReceivableScheduleLine {
  id                     String                       @id @db.Uuid
  tenantId               String                       @db.VarChar(128)
  receivableScheduleId   String                       @db.Uuid
  lineNo                 Int
  dueDate                String                       @db.VarChar(32)
  scheduledAmount        Decimal                      @db.Decimal(18, 6)
  allocatedAmount        Decimal                      @db.Decimal(18, 6)
  outstandingAmount      Decimal                      @db.Decimal(18, 6)
  status                 ReceivableScheduleLineStatus
  sourceSalesOrderLineId String?                      @db.VarChar(128)
  memo                   String?                      @db.VarChar(1000)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt

  receivableSchedule ReceivableSchedule @relation(fields: [receivableScheduleId], references: [id], onDelete: Cascade)

  @@unique([receivableScheduleId, lineNo])
  @@index([tenantId, receivableScheduleId, dueDate])
}

model PaymentAllocation {
  id                   String   @id @db.Uuid
  tenantId             String   @db.VarChar(128)
  accountTransactionId String   @db.Uuid
  paymentExecutionId   String?  @db.VarChar(128)
  paymentRequestId     String?  @db.VarChar(128)
  targetType           String   @db.VarChar(64)
  targetScheduleId     String   @db.Uuid
  targetScheduleLineId String   @db.Uuid
  allocatedAmount      Decimal  @db.Decimal(18, 6)
  currencyCode         String   @db.VarChar(16)
  allocatedAt          DateTime
  createdAt            DateTime @default(now())

  accountTransaction AccountTransaction @relation(fields: [accountTransactionId], references: [id], onDelete: Cascade)

  @@index([tenantId, accountTransactionId, allocatedAt])
  @@index([tenantId, paymentExecutionId, allocatedAt])
  @@index([tenantId, targetScheduleId, targetScheduleLineId])
}

model PaymentRequest {
  id                                    String                         @id @db.Uuid
  requestNo                             String                         @db.VarChar(64)
  tenantId                              String                         @db.VarChar(128)
  orgId                                 String?                        @db.VarChar(128)
  requestSource                         String                         @db.VarChar(64)
  sourcePurchaseOrderId                 String?                        @db.VarChar(128)
  supplierTenantPartyId                 String                         @db.VarChar(128)
  supplierSnapshot                      String                         @db.VarChar(255)
  beneficiarySupplierFinancialAccountId String                         @db.VarChar(128)
  currencyCode                          String                         @db.VarChar(16)
  requestedAmount                       Decimal                        @db.Decimal(18, 6)
  status                                String                         @db.VarChar(64)
  reason                                String?                        @db.VarChar(1000)
  requestedAt                           DateTime
  updatedAt                             DateTime                       @updatedAt
  lines                                 PaymentRequestLine[]
  evidenceSnapshots                     SupplierBillEvidenceSnapshot[]
  executions                            PaymentExecution[]

  @@unique([tenantId, requestNo])
  @@index([tenantId, sourcePurchaseOrderId, status])
  @@index([tenantId, supplierTenantPartyId, requestedAt])
}

model PaymentRequestLine {
  id                    String   @id @db.Uuid
  tenantId              String   @db.VarChar(128)
  paymentRequestId      String   @db.Uuid
  payableScheduleId     String   @db.Uuid
  payableScheduleLineId String   @db.Uuid
  scheduleDueDate       String   @db.VarChar(32)
  requestedAmount       Decimal  @db.Decimal(18, 6)
  executedAmount        Decimal  @db.Decimal(18, 6)
  isEarlyRequest        Boolean
  lineStatus            String   @db.VarChar(64)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  paymentRequest PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)

  @@index([tenantId, paymentRequestId])
  @@index([tenantId, payableScheduleId, payableScheduleLineId])
}

model SupplierBillEvidenceSnapshot {
  id                 String   @id @db.Uuid
  tenantId           String   @db.VarChar(128)
  paymentRequestId   String   @db.Uuid
  evidenceType       String   @db.VarChar(64)
  externalDocumentNo String?  @db.VarChar(255)
  documentDate       String?  @db.VarChar(32)
  currencyCode       String?  @db.VarChar(16)
  documentAmount     Decimal? @db.Decimal(18, 6)
  attachmentRef      String?  @db.VarChar(255)
  note               String?  @db.VarChar(1000)
  capturedAt         DateTime

  paymentRequest PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)

  @@index([tenantId, paymentRequestId, capturedAt])
}

model PaymentExecution {
  id                                    String   @id @db.Uuid
  tenantId                              String   @db.VarChar(128)
  orgId                                 String?  @db.VarChar(128)
  paymentRequestId                      String   @db.Uuid
  supplierTenantPartyId                 String   @db.VarChar(128)
  sourceFinancialAccountId              String   @db.Uuid
  beneficiarySupplierFinancialAccountId String?  @db.VarChar(128)
  beneficiaryAccountSnapshot            String?  @db.VarChar(255)
  executedAmount                        Decimal  @db.Decimal(18, 6)
  currencyCode                          String   @db.VarChar(16)
  executedAt                            DateTime
  executionReference                    String?  @db.VarChar(255)
  attachmentRefs                        Json
  linkedAccountTransactionId            String?  @db.VarChar(128)
  status                                String   @db.VarChar(64)
  createdAt                             DateTime @default(now())
  updatedAt                             DateTime @updatedAt

  paymentRequest PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)

  @@index([tenantId, paymentRequestId, executedAt])
  @@index([tenantId, supplierTenantPartyId, executedAt])
}

model FinanceReleaseSignal {
  id                    String                     @id @db.Uuid
  tenantId              String                     @db.VarChar(128)
  salesOrderId          String                     @db.VarChar(128)
  customerTenantPartyId String                     @db.VarChar(128)
  signalStatus          FinanceReleaseSignalStatus
  reasonCode            String?                    @db.VarChar(128)
  reasonSummary         String?                    @db.VarChar(1000)
  effectiveAt           DateTime
  expiresAt             DateTime?
  basedOnSummary        String?                    @db.VarChar(1000)
  updatedAt             DateTime                   @updatedAt

  @@index([tenantId, salesOrderId, effectiveAt])
}

model ExchangeRate {
  id                String   @id @db.Uuid
  tenantId          String   @db.VarChar(128)
  baseCurrencyCode  String   @db.VarChar(16)
  quoteCurrencyCode String   @db.VarChar(16)
  rateValue         Decimal  @db.Decimal(18, 6)
  effectiveAt       DateTime
  setBy             String   @db.VarChar(128)
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, baseCurrencyCode, quoteCurrencyCode, effectiveAt])
  @@index([tenantId, baseCurrencyCode, quoteCurrencyCode, effectiveAt])
}

model FinanceAuditEnvelope {
  id           String   @id
  service      String
  module       String
  eventType    String
  occurredAt   DateTime
  result       String
  operatorId   String?
  operatorType String
  tenantId     String?
  orgId        String?
  traceId      String?
  resourceType String
  resourceId   String?
  details      Json
  createdAt    DateTime @default(now())

  @@index([service, module, eventType, occurredAt])
  @@index([tenantId, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
}
