//File: src/services/system/resource-service/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["resource"]
}

model Domain {
  id          String   @id @default(uuid())
  value       String   @unique
  tenantId    String
  isVerified  Boolean  @default(false) // 是否通过dns验证, 只检测是否归属权，不检测dkim，spf 配置
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  records DomainRecord[]

  @@schema("resource")
}

model DomainRecord {
  id        String     @id @default(uuid())
  domainId  String
  type      RecordType
  name      String
  value     String
  ttl       Int        @default(600) // 600秒
  priority  Int? // 仅MX记录使用
  required  Boolean    @default(false) // 是否必须存在
  verified  Boolean    @default(false) // 是否通过dns验证
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  Domain    Domain     @relation(fields: [domainId], references: [id])

  @@schema("resource")
}

enum RecordType {
  A
  AAAA
  CNAME
  TXT
  MX
  SRV
  NS
  CAA

  @@schema("resource")
}
