generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WmsWarehouseScope {
  INTERNAL
}

enum WmsWarehouseStatus {
  ACTIVE
  INACTIVE
}

enum WmsLocationScope {
  INTERNAL
}

enum WmsLocationType {
  RECEIVING
  STORAGE
  STAGING
  RESTRICTED
}

enum WmsLocationStatus {
  ACTIVE
  INACTIVE
}

enum WmsReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum WmsReceiptSourceType {
  MANUAL
  RECEIVING_EXPECTATION_REFERENCE
}

enum WmsInventoryStatus {
  AVAILABLE
  RESTRICTED
}

enum WmsStockLedgerEntryType {
  RECEIPT_POSTED
}

enum WmsStockLedgerDirection {
  IN
}

enum WmsStockLedgerSourceDocumentType {
  RECEIPT
}

model WmsSequenceCounter {
  tenantId      String   @id @db.VarChar(128)
  nextReceiptNo Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Warehouse {
  id                         String             @id @db.VarChar(128)
  tenantId                   String             @db.VarChar(128)
  orgId                      String?            @db.VarChar(128)
  warehouseCode              String             @db.VarChar(128)
  warehouseName              String             @db.VarChar(255)
  warehouseScope             WmsWarehouseScope
  status                     WmsWarehouseStatus
  defaultReceivingLocationId String?            @db.VarChar(128)
  createdAt                  DateTime
  updatedAt                  DateTime

  @@unique([tenantId, warehouseCode])
  @@index([tenantId, orgId, status])
}

model Location {
  id               String            @id @db.VarChar(128)
  tenantId         String            @db.VarChar(128)
  warehouseId      String            @db.VarChar(128)
  parentLocationId String?           @db.VarChar(128)
  locationCode     String            @db.VarChar(128)
  locationName     String            @db.VarChar(255)
  locationScope    WmsLocationScope
  locationType     WmsLocationType
  status           WmsLocationStatus
  supportsReceipt  Boolean
  supportsStorage  Boolean
  createdAt        DateTime
  updatedAt        DateTime

  @@unique([warehouseId, locationCode])
  @@index([tenantId, warehouseId, locationType, status])
}

model Receipt {
  id                                String               @id @db.VarChar(128)
  receiptNo                         String               @unique @db.VarChar(64)
  tenantId                          String               @db.VarChar(128)
  orgId                             String?              @db.VarChar(128)
  warehouseId                       String               @db.VarChar(128)
  status                            WmsReceiptStatus
  receiptSourceType                 WmsReceiptSourceType
  referencedReceivingExpectationIds Json
  receiptDate                       String               @db.VarChar(64)
  note                              String?              @db.VarChar(500)
  attachmentRefs                    Json
  lineCount                         Int
  postedAt                          DateTime?
  cancelledAt                       DateTime?
  cancelReason                      String?              @db.VarChar(500)
  postComment                       String?              @db.VarChar(500)
  procurementReceiptSummary         Json?
  createdAt                         DateTime
  updatedAt                         DateTime
  lines                             ReceiptLine[]

  @@index([tenantId, warehouseId, status])
  @@index([tenantId, receiptDate])
}

model ReceiptLine {
  id                        String             @id @db.VarChar(128)
  tenantId                  String             @db.VarChar(128)
  receiptId                 String             @db.VarChar(128)
  lineNo                    Int
  itemId                    String             @db.VarChar(128)
  itemCode                  String?            @db.VarChar(128)
  itemName                  String?            @db.VarChar(255)
  receivingExpectationId    String?            @db.VarChar(128)
  targetLocationId          String             @db.VarChar(128)
  confirmedQuantity         String             @db.VarChar(64)
  uom                       String             @db.VarChar(64)
  inventoryStatus           WmsInventoryStatus
  restrictedReason          Json?
  trackingRefs              Json
  physicalDiscrepancy       Json?
  evidenceAttachmentRefs    Json
  postedStockLedgerEntryIds Json
  createdAt                 DateTime
  updatedAt                 DateTime
  receipt                    Receipt           @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@unique([receiptId, lineNo])
  @@index([tenantId, itemId])
  @@index([tenantId, receivingExpectationId])
}

model StockLedgerEntry {
  id                    String                       @id @db.VarChar(128)
  tenantId              String                       @db.VarChar(128)
  orgId                 String?                      @db.VarChar(128)
  entryType             WmsStockLedgerEntryType
  direction             WmsStockLedgerDirection
  warehouseId           String                       @db.VarChar(128)
  locationId            String                       @db.VarChar(128)
  itemId                String                       @db.VarChar(128)
  itemCode              String?                      @db.VarChar(128)
  itemName              String?                      @db.VarChar(255)
  quantityDelta         String                       @db.VarChar(64)
  uom                   String                       @db.VarChar(64)
  inventoryStatus       WmsInventoryStatus
  restrictedReason      Json?
  sourceDocumentType    WmsStockLedgerSourceDocumentType
  sourceDocumentId      String                       @db.VarChar(128)
  sourceDocumentLineId  String                       @db.VarChar(128)
  receivingExpectationId String?                     @db.VarChar(128)
  trackingRefs          Json
  postedAt              DateTime

  @@index([tenantId, warehouseId, itemId, postedAt])
  @@index([tenantId, sourceDocumentId, sourceDocumentLineId])
  @@index([tenantId, receivingExpectationId])
}

model InventoryBalance {
  balanceKey           String   @id @db.VarChar(255)
  tenantId             String   @db.VarChar(128)
  orgId                String?  @db.VarChar(128)
  warehouseId          String   @db.VarChar(128)
  locationId           String?  @db.VarChar(128)
  itemId               String   @db.VarChar(128)
  itemCode             String?  @db.VarChar(128)
  itemName             String?  @db.VarChar(255)
  uom                  String   @db.VarChar(64)
  onHandQuantity       String   @db.VarChar(64)
  availableQuantity    String   @db.VarChar(64)
  restrictedQuantity   String   @db.VarChar(64)
  restrictedQuantities Json
  lastLedgerEntryId    String   @db.VarChar(128)
  lastPostedAt         DateTime
  updatedAt            DateTime

  @@index([tenantId, warehouseId, itemId])
  @@index([tenantId, warehouseId, locationId, itemId])
}

model WmsAuditEnvelope {
  id           String   @id @db.VarChar(128)
  service      String   @db.VarChar(128)
  module       String   @db.VarChar(128)
  eventType    String   @db.VarChar(128)
  occurredAt   DateTime
  result       String   @db.VarChar(64)
  operatorId   String?  @db.VarChar(128)
  operatorType String?  @db.VarChar(64)
  tenantId     String?  @db.VarChar(128)
  orgId        String?  @db.VarChar(128)
  traceId      String?  @db.VarChar(128)
  resourceType String?  @db.VarChar(128)
  resourceId   String?  @db.VarChar(128)
  details      Json
  createdAt    DateTime

  @@index([tenantId, occurredAt])
}
