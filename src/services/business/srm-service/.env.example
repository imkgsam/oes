SERVICE_NAME="srm-service"
MODULE_NAME="srm-service"
GRPC_LISTEN_HOST="0.0.0.0"
GRPC_LISTEN_PORT="50061"
SERVICE_REGISTRY_PORT="50061"

# Default local infra creates `mydb`, so prefer one dedicated SRM schema on that shared database.
# If you maintain a dedicated PostgreSQL database for SRM, replace this with that isolated database URL.
DATABASE_URL="postgres://imkgsam:imkgsam@127.0.0.1:5432/mydb?schema=srm_service"

# Downstream party-service lookup used by BindSupplierToTenantParty.
GRPC_SERVICE_PARTY_URL="127.0.0.1:50053"

# Downstream item-master-service lookup used by UpsertSupplierOffering purchasable-item validation.
GRPC_SERVICE_ITEM_MASTER_URL="127.0.0.1:50058"
