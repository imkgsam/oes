SERVICE_NAME="mes-service"
MODULE_NAME="mes-service"
GRPC_LISTEN_HOST="0.0.0.0"
GRPC_LISTEN_PORT="50065"
SERVICE_REGISTRY_PORT="50065"

# Recommended local isolation: prefer a dedicated database or schema, e.g. ?schema=mes_service
DATABASE_URL="postgres://user:password@127.0.0.1:5432/oes?schema=mes_service"

# Live smoke rewrites DATABASE_URL to this schema before syncing and running.
MES_SMOKE_SCHEMA="mes_service_smoke"
