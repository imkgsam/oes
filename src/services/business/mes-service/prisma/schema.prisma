generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProductionSpec {
  id                            String   @id @db.VarChar(128)
  tenantId                      String   @db.VarChar(128)
  orgId                         String?  @db.VarChar(128)
  orgScope                      String   @default("") @db.VarChar(128)
  specCode                      String   @db.VarChar(128)
  name                          String   @db.VarChar(255)
  revisionCode                  String?  @db.VarChar(128)
  supersedesProductionSpecId    String?  @db.VarChar(128)
  itemRef                       Json
  status                        String   @db.VarChar(64)
  effectiveFrom                 String?  @db.VarChar(64)
  effectiveTo                   String?  @db.VarChar(64)
  retiredAt                     String?  @db.VarChar(64)
  replacementProductionSpecId   String?  @db.VarChar(128)
  createdAt                     DateTime
  updatedAt                     DateTime
  version                       Int

  @@unique([tenantId, orgScope, specCode])
  @@index([tenantId, orgId, status])
  @@index([tenantId, specCode])
}

model MoldDesign {
  id                       String             @id @db.VarChar(128)
  tenantId                 String             @db.VarChar(128)
  orgId                    String?            @db.VarChar(128)
  orgScope                 String             @default("") @db.VarChar(128)
  designCode               String             @db.VarChar(128)
  name                     String             @db.VarChar(255)
  revisionCode             String?            @db.VarChar(128)
  supersedesMoldDesignId   String?            @db.VarChar(128)
  primaryItemModelRef      Json
  productionSpecRefs       Json
  materialType             String             @db.VarChar(128)
  functionRole             String             @db.VarChar(64)
  productionMethodTags     String[]
  outputStructureType      String             @db.VarChar(64)
  defaultLifeLimit         String?            @db.VarChar(64)
  defaultLifeUnit          String?            @db.VarChar(64)
  status                   String             @db.VarChar(64)
  createdAt                DateTime
  updatedAt                DateTime
  outputs                  MoldDesignOutput[]

  @@unique([tenantId, orgScope, designCode])
  @@index([tenantId, orgId, status])
}

model MoldDesignOutput {
  id             String     @id @db.VarChar(128)
  tenantId       String     @db.VarChar(128)
  orgId          String?    @db.VarChar(128)
  moldDesignId   String     @db.VarChar(128)
  sequenceNo     Int
  outputCode     String     @db.VarChar(128)
  outputKind     String     @db.VarChar(64)
  productionSpecRef Json?
  itemModelRef   Json?
  quantityPerUse String     @db.VarChar(64)
  componentRole  String?    @db.VarChar(128)
  assemblyHint   String?    @db.VarChar(255)
  isPrimaryOutput Boolean
  options        Json
  moldDesign     MoldDesign @relation(fields: [moldDesignId], references: [id], onDelete: Cascade)

  @@index([tenantId, moldDesignId])
}

model MasterMold {
  id                        String   @id @db.VarChar(128)
  tenantId                  String   @db.VarChar(128)
  orgId                     String?  @db.VarChar(128)
  orgScope                  String   @default("") @db.VarChar(128)
  masterMoldCode            String   @db.VarChar(128)
  moldDesignId              String   @db.VarChar(128)
  supplierRef               Json?
  purchaseRef               Json?
  receivedAt                String?  @db.VarChar(64)
  currentStatus             String   @db.VarChar(64)
  currentStorageResourceRef Json?
  currentCarrierResourceRef Json?
  qualitySummary            String?  @db.VarChar(1000)
  notes                     String?  @db.VarChar(1000)
  createdAt                 DateTime
  updatedAt                 DateTime

  @@unique([tenantId, orgScope, masterMoldCode])
  @@index([tenantId, moldDesignId])
}

model ProductionMold {
  id                         String   @id @db.VarChar(128)
  tenantId                   String   @db.VarChar(128)
  orgId                      String?  @db.VarChar(128)
  orgScope                   String   @default("") @db.VarChar(128)
  moldCode                   String   @db.VarChar(128)
  moldDesignId               String   @db.VarChar(128)
  sourceMasterMoldId         String?  @db.VarChar(128)
  supplierRef                Json?
  purchaseRef                Json?
  receivedAt                 String?  @db.VarChar(64)
  acceptedAt                 String?  @db.VarChar(64)
  currentStatus              String   @db.VarChar(64)
  currentStorageResourceRef  Json?
  currentCarrierResourceRef  Json?
  currentInstallationSummary Json?
  lifeCounterSummary         Json?
  scrappedAt                 String?  @db.VarChar(64)
  createdAt                  DateTime
  updatedAt                  DateTime

  @@unique([tenantId, orgScope, moldCode])
  @@index([tenantId, moldDesignId, currentStatus])
}

model StorageResource {
  id           String   @id @db.VarChar(128)
  tenantId     String   @db.VarChar(128)
  orgId        String?  @db.VarChar(128)
  orgScope     String   @default("") @db.VarChar(128)
  resourceCode String   @db.VarChar(128)
  name         String   @db.VarChar(255)
  status       String   @db.VarChar(64)
  createdAt    DateTime
  updatedAt    DateTime

  @@unique([tenantId, orgScope, resourceCode])
  @@index([tenantId, orgId, status])
}

model CarrierResource {
  id           String   @id @db.VarChar(128)
  tenantId     String   @db.VarChar(128)
  orgId        String?  @db.VarChar(128)
  orgScope     String   @default("") @db.VarChar(128)
  resourceCode String   @db.VarChar(128)
  name         String   @db.VarChar(255)
  status       String   @db.VarChar(64)
  createdAt    DateTime
  updatedAt    DateTime

  @@unique([tenantId, orgScope, resourceCode])
  @@index([tenantId, orgId, status])
}

model WorkCenter {
  id             String   @id @db.VarChar(128)
  tenantId       String   @db.VarChar(128)
  orgId          String?  @db.VarChar(128)
  orgScope       String   @default("") @db.VarChar(128)
  workCenterCode String   @db.VarChar(128)
  name           String   @db.VarChar(255)
  workCenterType String?  @db.VarChar(128)
  areaId         String?  @db.VarChar(128)
  status         String   @db.VarChar(64)
  createdAt      DateTime
  updatedAt      DateTime

  @@unique([tenantId, orgScope, workCenterCode])
  @@index([tenantId, orgId, status])
}

model WorkUnit {
  id           String   @id @db.VarChar(128)
  tenantId     String   @db.VarChar(128)
  orgId        String?  @db.VarChar(128)
  workCenterId String   @db.VarChar(128)
  workUnitCode String   @db.VarChar(128)
  name         String   @db.VarChar(255)
  status       String   @db.VarChar(64)
  createdAt    DateTime
  updatedAt    DateTime

  @@unique([tenantId, workCenterId, workUnitCode])
  @@index([tenantId, workCenterId, status])
}

model MoldMovement {
  id                     String   @id @db.VarChar(128)
  tenantId               String   @db.VarChar(128)
  orgId                  String?  @db.VarChar(128)
  toolingType            String   @db.VarChar(64)
  toolingId              String   @db.VarChar(128)
  fromStorageResourceRef Json?
  fromCarrierResourceRef Json?
  toStorageResourceRef   Json?
  toCarrierResourceRef   Json?
  movementReason         String?  @db.VarChar(500)
  movedAt                DateTime
  operatorRef            Json
  auditRef               Json

  @@index([tenantId, toolingType, toolingId, movedAt])
}

model ToolingInstallation {
  id              String   @id @db.VarChar(128)
  tenantId        String   @db.VarChar(128)
  orgId           String?  @db.VarChar(128)
  toolingType     String   @db.VarChar(64)
  toolingId       String   @db.VarChar(128)
  workCenterRef   Json
  workUnitRef     Json?
  installedAt     DateTime
  unmountedAt     DateTime?
  installedByRef  Json?
  unmountedByRef  Json?
  status          String   @db.VarChar(64)
  auditRef        Json
  moldDetail      MoldInstallationDetail?

  @@index([tenantId, toolingType, toolingId, status])
  @@index([tenantId, status])
}

model MoldInstallationDetail {
  toolingInstallationId String              @id @db.VarChar(128)
  moldPositionIndex     Int
  cavityPosition        String?             @db.VarChar(128)
  cavityMapping         String?             @db.VarChar(1000)
  setupParameters       String?             @db.VarChar(1000)
  toolingInstallation   ToolingInstallation @relation(fields: [toolingInstallationId], references: [id], onDelete: Cascade)
}

model MoldUsageRecord {
  id                       String   @id @db.VarChar(128)
  tenantId                 String   @db.VarChar(128)
  orgId                    String?  @db.VarChar(128)
  productionMoldId         String   @db.VarChar(128)
  toolingInstallationId    String?  @db.VarChar(128)
  workCenterRef            Json
  workUnitRef              Json?
  usedAt                   DateTime
  usageQuantity            String   @db.VarChar(64)
  lifeDelta                String   @db.VarChar(64)
  lifeUnit                 String   @db.VarChar(64)
  productionSpecRef        Json?
  productionUnitRef        Json?
  traceSubjectRef          Json?
  operatorRef              Json
  captureSource            String?  @db.VarChar(128)
  auditRef                 Json
  moldDesignOutputId       String?  @db.VarChar(128)
  moldDesignOutputOptionId String?  @db.VarChar(128)

  @@index([tenantId, productionMoldId, usedAt])
}

model MoldLifeCounter {
  id                    String   @id @db.VarChar(128)
  tenantId              String   @db.VarChar(128)
  orgId                 String?  @db.VarChar(128)
  productionMoldId      String   @unique @db.VarChar(128)
  lifeUnit              String   @db.VarChar(64)
  usedValue             String   @db.VarChar(64)
  limitValue            String?  @db.VarChar(64)
  warningThresholdValue String?  @db.VarChar(64)
  lastUsageRecordId     String?  @db.VarChar(128)
  lastAdjustedAt        DateTime?
  lastAdjustedByRef     Json?
  adjustmentReason      String?  @db.VarChar(500)
  updatedAt             DateTime

  @@index([tenantId, productionMoldId])
}

model MesAuditEnvelope {
  id             String   @id @db.VarChar(128)
  tenantId       String   @db.VarChar(128)
  orgId          String?  @db.VarChar(128)
  service        String   @db.VarChar(128)
  module         String   @db.VarChar(128)
  eventType      String   @db.VarChar(128)
  occurredAt     DateTime
  result         String   @db.VarChar(64)
  operatorId     String   @db.VarChar(128)
  operatorType   String   @db.VarChar(64)
  traceId        String   @db.VarChar(128)
  commandId      String   @db.VarChar(128)
  reason         String   @db.VarChar(500)
  resourceType   String?  @db.VarChar(128)
  resourceId     String?  @db.VarChar(128)
  beforeSnapshot Json?
  afterSnapshot  Json?
  details        Json
  createdAt      DateTime

  @@index([tenantId, occurredAt])
  @@index([tenantId, commandId])
}

model MesOutboxEvent {
  id            String   @id @db.VarChar(128)
  tenantId      String   @db.VarChar(128)
  orgId         String?  @db.VarChar(128)
  eventType     String   @db.VarChar(128)
  aggregateType String   @db.VarChar(128)
  aggregateId   String   @db.VarChar(128)
  payload       Json
  traceId       String   @db.VarChar(128)
  commandId     String   @db.VarChar(128)
  occurredAt    DateTime
  publishedAt   DateTime?
  status        String   @db.VarChar(64)
  createdAt     DateTime

  @@index([tenantId, eventType, status])
  @@index([tenantId, aggregateType, aggregateId])
}

model MesCommandIdempotency {
  id               String   @id @db.VarChar(128)
  tenantId         String   @db.VarChar(128)
  orgId            String?  @db.VarChar(128)
  commandId        String   @db.VarChar(128)
  commandName      String   @db.VarChar(128)
  requestHash      String   @db.VarChar(128)
  status           String   @db.VarChar(64)
  responseSnapshot Json?
  createdAt        DateTime
  updatedAt        DateTime

  @@unique([tenantId, commandId])
  @@index([tenantId, status, updatedAt])
}
