// src/services/system/auth-service/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LoginMethod {
  id          String          @id @default(uuid())
  userId      String //关联至identity-service 中的 user
  type        LoginMethodType
  identifier  String
  verified    Boolean         @default(false)
  enabled     Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  credentials Credential[]

  @@unique([type, identifier])
}

enum LoginMethodType {
  EMAIL
  PHONE
  OAUTH_OPENID
  TERMINAL_PIN
}

model Credential {
  id             String         @id @default(uuid())
  loginMethodId  String
  credentialType CredentialType
  hashedValue    String? // 如果type是password，则存储哈希后的密码， 反之则为空
  provider       String? // 第三方登录提供商，例如 google, facebook
  enabled        Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  LoginMethod LoginMethod @relation(fields: [loginMethodId], references: [id])
}

enum CredentialType {
  PASSWORD
  EMAIL_OTP
  PHONE_OTP
  OAUTH
  TERMINAL_PIN
}

model PasswordSetupRequirement {
  id          String              @id @default(uuid())
  userId      String              @unique
  required    Boolean             @default(true)
  reason      PasswordSetupReason
  requiredBy  String?
  requiredAt  DateTime            @default(now())
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

enum PasswordSetupReason {
  FIRST_LOGIN
  ADMIN_RESET
  SECURITY_POLICY
}

model TerminalPinResetRequirement {
  id          String                 @id @default(uuid())
  userId      String                 @unique
  required    Boolean                @default(true)
  reason      TerminalPinResetReason
  requiredBy  String?
  requiredAt  DateTime               @default(now())
  completedAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

enum TerminalPinResetReason {
  ADMIN_RESET
  SECURITY_POLICY
}

enum TenantMfaScenario {
  LOGIN
  NEW_DEVICE_LOGIN
  CHANGE_PASSWORD
  CHANGE_CONTACT
}

enum ScopeLevel {
  SYSTEM
  TENANT
}

model OTP {
  id           String   @id @default(uuid())
  type         OTPType  @default(EMAIL)
  usage        OTPUsage
  identifier   String
  hashedValue  String
  lastSentAt   DateTime
  dailyCount   Int      @default(0) // 当天已发送次数
  consumed     Boolean  @default(false)
  attemptCount Int      @default(0)
  maxAttempt   Int      @default(1)
  valid        Boolean  @default(true)
  expiredAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([identifier, usage])
}

enum OTPType {
  EMAIL
  PHONE
}

model PasswordRecoveryGrant {
  id            String    @id
  userId        String
  loginMethodId String
  challengeId   String    @unique
  expiresAt     DateTime
  verifiedAt    DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([loginMethodId])
}

enum OTPUsage {
  LOGIN
  REGISTER
  RESET_PASSWORD
  MFA_VERIFY
}

enum DeviceType {
  WEB
  MINI_PROGRAM
  MOBILE_APP
  DESKTOP_APP
  PDA
}

/// TODO(auth-session-storage): UserSession is not used by the current runtime session repository.
/// Pending decision: remove this model or convert it into durable session-history/audit storage.
model UserSession {
  id               String     @id @default(uuid())
  userId           String //关联identity-service中的user
  currentAccountId String? //关联identity-service中的account， 当前会话所使用的账号
  loginMethodId    String
  deviceType       DeviceType
  deviceInfo       String?
  ipAddress        String?
  refreshTokenHash String     @unique
  issuedAt         DateTime   @default(now())
  revoked          Boolean    @default(false)
  revokedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  expiresAt        DateTime //session 过期时间

  @@index([refreshTokenHash])
  @@index([userId, revoked])
}

model MfaBinding {
  id         String   @id @default(uuid())
  userId     String //关联identity-service中的user
  type       MfaType
  secret     String
  enabled    Boolean  @default(true)
  metadata   String?
  deviceInfo String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, type])
}

model TenantMfaScenarioPolicy {
  tenantId  String
  scenario  TenantMfaScenario
  required  Boolean           @default(false)
  updatedBy String?
  updatedAt DateTime          @updatedAt
  createdAt DateTime          @default(now())

  @@id([tenantId, scenario])
}

model TenantMfaFactorPolicy {
  tenantId  String
  factor    MfaType
  enabled   Boolean  @default(true)
  priority  Int
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@id([tenantId, factor])
}

model PlatformMfaScenarioPolicy {
  scopeKey  String
  scenario  TenantMfaScenario
  required  Boolean           @default(false)
  updatedBy String?
  updatedAt DateTime          @updatedAt
  createdAt DateTime          @default(now())

  @@id([scopeKey, scenario])
}

model PlatformMfaFactorPolicy {
  scopeKey  String
  factor    MfaType
  enabled   Boolean  @default(true)
  priority  Int
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@id([scopeKey, factor])
}

model TerminalLoginPolicy {
  id                String   @id @default(uuid())
  terminal          String   @unique
  enabledLoginFlows Json
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PlatformTerminalMfaPolicy {
  id                   String   @id @default(uuid())
  terminal             String   @unique
  loginMfaRequired     Boolean  @default(false)
  newDeviceMfaRequired Boolean  @default(false)
  allowedFactors       Json
  factorPriority       Json
  updatedBy            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model TenantTerminalMfaPolicy {
  id                   String   @id @default(uuid())
  tenantId             String
  terminal             String
  loginMfaRequired     Boolean  @default(false)
  newDeviceMfaRequired Boolean  @default(false)
  allowedFactors       Json
  factorPriority       Json
  updatedBy            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([tenantId, terminal])
  @@index([tenantId])
}

model TrustedDevice {
  id            String     @id @default(uuid())
  userId        String
  scopeLevel    ScopeLevel @default(TENANT)
  scopeKey      String     @default("")
  tenantId      String?
  deviceId      String
  deviceName    String?
  browser       String?
  platform      String?
  userAgent     String?
  lastIpAddress String?
  trustedAt     DateTime   @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  lastSeenAt    DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([userId, scopeKey, deviceId])
  @@index([scopeKey, userId])
  @@index([scopeKey, userId, revokedAt])
}

enum MfaType {
  TOTP
  EMAIL_OTP
  SMS_OTP
  BACKUP_CODE
  PUSH_NOTIFICATION
  HARDWARE_TOKEN
  BIOMETRIC
}

model AuditEvent {
  id           String   @id
  service      String
  module       String
  eventType    String
  occurredAt   DateTime
  result       String
  operatorId   String?
  operatorType String
  tenantId     String?
  orgId        String?
  traceId      String?
  resourceType String
  resourceId   String?
  details      Json
  createdAt    DateTime @default(now())
  machineWorkloadSourceCredentials MachineWorkloadSourceCredential[]

  @@index([service, module, eventType, occurredAt])
  @@index([tenantId, occurredAt])
  @@index([operatorId, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
}

model ExecutionTokenRevocation {
  selectorKind      String
  selectorRef       String
  revocationVersion Int
  effectiveAt       DateTime
  denyUntil         DateTime
  reasonCode        String
  auditRef          String
  traceId           String
  correlationId     String?
  createdAt         DateTime @default(now())

  @@id([selectorKind, selectorRef])
}

model AuthEventOutbox {
  eventId      String   @id
  eventType    String
  eventVersion Int
  payload      Json
  occurredAt   DateTime
  createdAt    DateTime @default(now())

  @@index([eventType, occurredAt])
}

model ExternalApiKeyCredential {
  id                     String    @id @default(uuid())
  integrationMachineId   String
  tenantId               String
  keyIdentifier          String    @unique
  verifier               String
  verifierKeyVersion     String
  status                 String    @default("ACTIVE")
  expiresAt              DateTime
  supersedesCredentialId String?
  predecessorValidUntil  DateTime?
  revokedAt              DateTime?
  lastUsedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([integrationMachineId, tenantId])
}

model MachineWorkloadSourceCredential {
  id                            String   @id
  machinePrincipalId            String
  machineWorkloadBindingId      String
  machineWorkloadBindingVersion BigInt
  workloadSpiffeId              String
  certificateThumbprint         String
  certificateNotAfter           DateTime
  profileVersion                Int
  signingKid                    String
  issuedAt                      DateTime
  expiresAt                     DateTime
  status                        String
  predecessorId                 String?
  revokedAt                     DateTime?
  revokedReasonCode             String?
  auditId                       String    @unique
  traceId                       String?
  createdAt                     DateTime  @default(now())
  audit                         AuditEvent @relation(fields: [auditId], references: [id], onDelete: Restrict)
  predecessor                   MachineWorkloadSourceCredential? @relation("MachineWorkloadCredentialSupersession", fields: [predecessorId], references: [id], onDelete: Restrict)
  successors                    MachineWorkloadSourceCredential[] @relation("MachineWorkloadCredentialSupersession")

  @@index([machineWorkloadBindingId, status])
  @@index([machinePrincipalId, expiresAt])
}

model ExternalApiKeyVerifierCompromiseIncident {
  incidentReference             String   @id
  verifierKeyVersion            String   @unique
  occurredAt                    DateTime
  processedAt                   DateTime
  stateRevision                 String
  workloadSubject               String
  workloadClientId              String
  requestId                     String?
  traceId                       String?
  matchedCredentialCount        Int
  newlyRevokedCredentialCount   Int
  alreadyRevokedCredentialCount Int
  createdAt                     DateTime @default(now())
}
