// src/services/system/auth-service/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LoginMethod {
  id          String          @id @default(uuid())
  userId      String //关联至identity-service 中的 user
  type        LoginMethodType
  identifier  String
  verified    Boolean         @default(false)
  enabled     Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  credentials Credential[]

  @@unique([type, identifier])
}

enum LoginMethodType {
  EMAIL
  PHONE
  OAUTH_OPENID
}

model Credential {
  id             String         @id @default(uuid())
  loginMethodId  String
  credentialType CredentialType
  hashedValue    String? // 如果type是password，则存储哈希后的密码， 反之则为空
  provider       String? // 第三方登录提供商，例如 google, facebook
  enabled        Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  LoginMethod LoginMethod @relation(fields: [loginMethodId], references: [id])
}

enum CredentialType {
  PASSWORD
  EMAIL_OTP
  PHONE_OTP
  OAUTH
}

model PasswordSetupRequirement {
  id          String              @id @default(uuid())
  userId      String              @unique
  required    Boolean             @default(true)
  reason      PasswordSetupReason
  requiredBy  String?
  requiredAt  DateTime            @default(now())
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

enum PasswordSetupReason {
  FIRST_LOGIN
  ADMIN_RESET
  SECURITY_POLICY
}

enum TenantMfaScenario {
  LOGIN
}

model OTP {
  id           String   @id @default(uuid())
  usage        OTPUsage
  identifier   String
  hashedValue  String
  lastSentAt   DateTime
  dailyCount   Int      @default(0) // 当天已发送次数
  consumed     Boolean  @default(false)
  attemptCount Int      @default(0)
  maxAttempt   Int      @default(1)
  valid        Boolean  @default(true)
  expiredAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([identifier, usage])
}

model PasswordRecoveryGrant {
  id            String   @id
  userId        String
  loginMethodId String
  challengeId   String   @unique
  expiresAt     DateTime
  verifiedAt    DateTime
  consumedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([loginMethodId])
}

enum OTPUsage {
  LOGIN
  REGISTER
  RESET_PASSWORD
  MFA_VERIFY
}

enum DeviceType {
  WEB
  MINI_PROGRAM
  MOBILE_APP
  DESKTOP_APP
  PDA
}

model UserSession {
  id               String     @id @default(uuid())
  userId           String //关联identity-service中的user
  currentAccountId String? //关联identity-service中的account， 当前会话所使用的账号
  loginMethodId    String
  deviceType       DeviceType
  deviceInfo       String?
  ipAddress        String?
  refreshTokenHash String     @unique
  issuedAt         DateTime   @default(now())
  revoked          Boolean    @default(false)
  revokedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  expiresAt        DateTime //session 过期时间

  @@index([refreshTokenHash])
  @@index([userId, revoked])
}

model MfaBinding {
  id         String   @id @default(uuid())
  userId     String //关联identity-service中的user
  type       MfaType
  secret     String
  enabled    Boolean  @default(true)
  metadata   String?
  deviceInfo String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, type])
}

model TenantMfaScenarioPolicy {
  tenantId   String
  scenario   TenantMfaScenario
  required   Boolean            @default(false)
  updatedBy  String?
  updatedAt  DateTime           @updatedAt
  createdAt  DateTime           @default(now())

  @@id([tenantId, scenario])
}

model TenantMfaFactorPolicy {
  tenantId   String
  factor     MfaType
  enabled    Boolean  @default(true)
  priority   Int
  updatedBy  String?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@id([tenantId, factor])
}

enum MfaType {
  TOTP
  EMAIL_OTP
  SMS_OTP
  BACKUP_CODE
  PUSH_NOTIFICATION
  HARDWARE_TOKEN
  BIOMETRIC
}

model AuditEvent {
  id           String   @id
  service      String
  module       String
  eventType    String
  occurredAt   DateTime
  result       String
  operatorId   String?
  operatorType String
  tenantId     String?
  orgId        String?
  traceId      String?
  resourceType String
  resourceId   String?
  details      Json
  createdAt    DateTime @default(now())

  @@index([service, module, eventType, occurredAt])
  @@index([tenantId, occurredAt])
  @@index([operatorId, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
}
