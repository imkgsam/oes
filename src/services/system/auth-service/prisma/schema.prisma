generator client {
  provider        = "prisma-client-js"
  output          = "../prisma/generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth"]
}

model LoginMethod {
  id         String          @id @default(uuid())
  userId     String //关联至identity 中的user
  type       LoginMethodType
  identifier String //例子 testing@email.com
  verified   Boolean         @default(false)
  enabled    Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  credentials Credential[] // 一个loginmethod可以有多个credentials，例如邮箱可以通过密码以及otp登录，手机可以密码或者otp，oauth可以是wechat/google

  @@unique([type, identifier])
  @@schema("auth")
}

enum LoginMethodType {
  EMAIL
  PHONE
  OAUTH_OPENID

  @@schema("auth")
}

model Credential {
  id            String         @id @default(uuid())
  loginMethodId String // 关联的登录方式，例如email、phone、 oauth
  secretType    CredentialType // 可以是密码 或者是email_otp
  secretValue   String?
  provider      String?
  enabled       Boolean        @default(true) // 默认启用
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  LoginMethods LoginMethod @relation(fields: [loginMethodId], references: [id])

  @@schema("auth")
}

enum CredentialType {
  PASSWORD
  EMAIL_OTP
  PHONE_OTP
  OAUTH

  @@schema("auth")
}

model OneTimeToken {
  id           String   @id @default(uuid())
  type         OtpType
  usage        OtpUsage
  identifier   String
  code         String
  expiredAt    DateTime
  consumed     Boolean  @default(false)
  attemptCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([identifier, usage])
  @@schema("auth")
}

enum OtpType {
  EMAIL
  PHONE
  TOTP
  BACKUP_CODE

  @@schema("auth")
}

enum OtpUsage {
  LOGIN
  REGISTER
  RESET_PASSWORD
  MFA_VERIFY

  @@schema("auth")
}
