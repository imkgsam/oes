generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth"]
}

model LoginMethod {
  id         String          @id @default(uuid())
  userId     String //关联至identity 中的user
  type       LoginMethodType
  identifier String //例子 testing@email.com
  verified   Boolean         @default(false)
  enabled    Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  credentials Credential[] // 一个loginmethod可以有多个credentials，例如邮箱可以通过密码以及otp登录，手机可以密码或者otp，oauth可以是wechat/google

  @@unique([type, identifier])
  @@schema("auth")
}

enum LoginMethodType {
  EMAIL
  PHONE
  OAUTH_OPENID

  @@schema("auth")
}

model Credential {
  id             String         @id @default(uuid())
  loginMethodId  String // 关联的登录方式，例如email、phone、 oauth
  credentialType CredentialType // 可以是密码 或者是email_otp
  secretValue    String?
  provider       String? // 第三方登录提供商，例如 google, facebook
  enabled        Boolean        @default(true) // 默认启用

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  LoginMethod LoginMethod @relation(fields: [loginMethodId], references: [id])

  @@schema("auth")
}

enum CredentialType {
  PASSWORD
  EMAIL_OTP
  PHONE_OTP
  OAUTH

  @@schema("auth")
}

model OneTimeToken {
  id           String   @id @default(uuid())
  type         OtpType
  usage        OtpUsage
  identifier   String
  code         String
  consumed     Boolean  @default(false)
  attemptCount Int      @default(0)
  maxAttempt   Int      @default(1)
  valid        Boolean  @default(true)
  expiredAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([identifier, usage])
  @@schema("auth")
}

enum OtpType {
  EMAIL
  PHONE

  @@schema("auth")
}

enum OtpUsage {
  LOGIN
  REGISTER
  RESET_PASSWORD
  MFA_VERIFY

  @@schema("auth")
}

enum DeviceType {
  WEB
  MINI_PROGRAM
  MOBILE_APP
  DESKTOP_APP
  PDA

  @@schema("auth")
}

model UserSession {
  id            String     @id @default(uuid())
  userId        String // 关联至identity 中的user
  loginMethodId String //登录方式，例如邮箱、手机、oauth
  deviceType    DeviceType
  deviceInfo    String? // JSON 格式的设备信息
  ipAddress     String? //登录IP地址
  refreshToken  String     @unique
  issuedAt      DateTime   @default(now())
  revoked       Boolean    @default(false)
  revokedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  expiresAt     DateTime //session 过期时间

  @@index([userId, deviceType])
  @@index([refreshToken])
  @@schema("auth")
}

// 推迟实现： 多重因素认证
model MfaBinding {
  id         String   @id @default(uuid())
  userId     String
  type       MfaType
  secret     String
  enabled    Boolean  @default(true)
  metadata   String? // JSON 格式的元数据，用于存储额外配置
  deviceInfo String? // JSON 格式的设备信息
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, type]) // 每个用户每种类型只能有一个绑定
  @@schema("auth")
}

enum MfaType {
  TOTP
  EMAIL_OTP
  SMS_OTP
  BACKUP_CODE
  PUSH_NOTIFICATION
  HARDWARE_TOKEN
  BIOMETRIC

  @@schema("auth")
}
