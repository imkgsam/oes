generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrgUnitStatus {
  ACTIVE
  ARCHIVED
}

enum OrgUnitType {
  ROOT
  DEPARTMENT
  TEAM
  BRANCH
  OTHER
}

enum TenantOnboardingRunStatus {
  PENDING
  RUNNING
  FAILED_RETRYABLE
  FAILED_NEEDS_MANUAL_REVIEW
  SUCCEEDED
}

model Tenant {
  id                 String       @id @default(uuid()) @db.Uuid
  code               String       @unique @db.VarChar(100)
  employeeCodePrefix String       @unique @db.VarChar(3)
  name               String       @db.VarChar(255)
  websiteUrl         String?      @db.VarChar(2048)
  status             TenantStatus @default(ACTIVE)
  rootOrgId          String?      @db.Uuid
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  orgUnits           OrgUnit[]
}

model OrgUnit {
  id                  String        @id @default(uuid()) @db.Uuid
  tenantId            String        @db.Uuid
  parentOrgId         String?       @db.Uuid
  name                String        @db.VarChar(255)
  type                OrgUnitType
  status              OrgUnitStatus @default(ACTIVE)
  path                String        @db.VarChar(2048)
  depth               Int
  sortOrder           Int           @default(0)
  organizationTenantPartyId String?       @db.Uuid
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   OrgUnit?  @relation("OrgUnitTree", fields: [parentOrgId], references: [id])
  children OrgUnit[] @relation("OrgUnitTree")

  @@unique([tenantId, parentOrgId, name])
  @@index([tenantId])
  @@index([parentOrgId])
  @@index([path])
}

model TenantOnboardingRun {
  id             String                    @id @default(uuid()) @db.Uuid
  idempotencyKey String                    @unique @db.VarChar(128)
  requestHash    String                    @db.VarChar(128)
  status         TenantOnboardingRunStatus @default(PENDING)
  requestPayload Json
  externalRefs   Json
  steps          Json
  failure        Json?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([status])
  @@index([createdAt])
}
