// src/services/system/permission-service/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum level {
  PLATFORM
  TENANT
}

model Role {
  id          String   @id @default(uuid())
  type        level    @default(TENANT)
  tenantId    String? // 指向 identity-service 的 Tenant.id
  code        String // 角色唯一代码，例如 "admin"
  name        String // 角色名称，例如 "管理员"
  description String?
  module      String // 所属模块，如 "finance"、"crm"
  isSystem    Boolean  @default(false) // 是否为系统内置角色
  autoGrant   Boolean  @default(false) // 是否新用户自动赋予
  isEnabled   Boolean  @default(true) // 是否启用
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  accounts    AccountRole[]

  @@unique([tenantId, code])
}

enum Modules {
  ENTITY_SERVICE
  IDENTITY_SERVICE
  PERMISSION_SERVICE
  AUTH_SERVICE
  EPR_SERVICE
  MES_SERVICE
  WMS_SERVICE
}

model Permission {
  id          String           @id @default(uuid())
  tenantId    String? // 外部字段，表示权限属于哪个租户（可为 null 表示平台权限）
  code        String // 权限代码，如 "order:read"
  description String?
  module      Modules
  roles       RolePermission[]

  @@unique([tenantId, code])
}

model AccountRole {
  id          String      @id @default(uuid())
  accountType AccountType
  accountId   String // 指向 identity-service 中 serviceAccount.id 或 userAccount.id
  roleId      String
  tenantId    String // 冗余字段，方便查询
  role        Role        @relation(fields: [roleId], references: [id])

  @@unique([accountId, roleId])
  @@index([accountId, tenantId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model AccountScope {
  id             String      @id @default(uuid())
  holderType     AccountType
  holderId       String // 指向identity-service 中 serviceAccount.id 或 userAccount.id
  tenantId       String // 指向identity-service 中 tenant.id
  isActive       Boolean     @default(true)
  permissionCode String
  resourceType   String
  resourceId     String
  expiredAt      DateTime?

  @@index([holderId, permissionCode])
  @@index([holderId, resourceType, resourceId])
  @@index([holderId, tenantId])
}

enum AccountType {
  USER
  SERVICE
}
