// src/services/system/permission-service/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// RBAC core model
// ============================================================

model Role {
  id          String   @id @default(uuid())
  tenantId    String? // null = global role
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  accounts    AccountRole[]
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique
  description String?
  module      Modules

  roles RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model AccountRole {
  id          String      @id @default(uuid())
  accountType AccountType
  accountId   String
  roleId      String
  tenantId    String
  role        Role        @relation(fields: [roleId], references: [id])

  @@unique([accountId, roleId])
  @@index([accountId, tenantId])
}

// ============================================================
// ABAC policy model
// ============================================================

model Policy {
  id             String            @id @default(uuid())
  name           String
  description    String?
  tenantId       String? // null = global policy
  effect         PolicyEffect
  subjectType    PolicySubjectType @default(ANY)
  subjectId      String? // ROLE uses roleCode, ACCOUNT uses accountId
  permissionCode String? // null = applies to all permissions
  resourceType   String? // null = applies to all resource types
  priority       Int               @default(0)
  isEnabled      Boolean           @default(true)
  conditions     PolicyCondition[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([tenantId, isEnabled])
  @@index([permissionCode])
  @@index([subjectType, subjectId])
}

model PolicyCondition {
  id              String            @id @default(uuid())
  policyId        String
  policy          Policy            @relation(fields: [policyId], references: [id], onDelete: Cascade)
  attributeSource AttributeSource
  attributeKey    String
  operator        ConditionOperator
  value           String // JSON encoded, supports $subject.xxx dynamic refs

  @@index([policyId])
}

// ============================================================
// Enums
// ============================================================

enum Modules {
  ENTITY_SERVICE
  IDENTITY_SERVICE
  PERMISSION_SERVICE
  AUTH_SERVICE
  EPR_SERVICE
  MES_SERVICE
  WMS_SERVICE
}

enum AccountType {
  USER
  SERVICE
}

enum PolicyEffect {
  ALLOW
  DENY
}

enum PolicySubjectType {
  ROLE
  ACCOUNT
  ANY
}

enum AttributeSource {
  SUBJECT
  RESOURCE
  ENVIRONMENT
  ACTION
}

enum ConditionOperator {
  EQUALS
  NOT_EQUALS
  IN
  NOT_IN
  GREATER_THAN
  GREATER_THAN_OR_EQUAL
  LESS_THAN
  LESS_THAN_OR_EQUAL
  BETWEEN
  CONTAINS
  STARTS_WITH
  REGEX
  IS_NULL
  IS_NOT_NULL
}
