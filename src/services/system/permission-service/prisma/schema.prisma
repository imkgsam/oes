// src/services/system/permission-service/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// RBAC core model
// ============================================================

model Role {
  id             String   @id @default(uuid())
  tenantId       String? // null = system template or system instance
  scopeKey       String // "__SYSTEM_TEMPLATE__" for templates, "__SYSTEM__" for system instances, tenantId for tenant instances
  code           String
  name           String
  description    String?
  kind           RoleKind
  templateRoleId String?
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  permissions  RolePermission[]
  accounts     AccountRole[]
  navigationVisibilities RoleNavigationVisibility[]
  landingPolicies RoleLandingPolicy[]
  templateRole Role?            @relation("RoleTemplateInstances", fields: [templateRoleId], references: [id])
  instances    Role[]           @relation("RoleTemplateInstances")

  @@unique([scopeKey, kind, code])
  @@index([tenantId, kind])
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  module      Modules
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles    RolePermission[]
  policies Policy[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model AccountRole {
  id          String      @id @default(uuid())
  accountType AccountType
  accountId   String
  roleId      String
  tenantId    String?
  scopeLevel  ScopeLevel  @default(TENANT)
  effectiveAt DateTime?
  expiresAt   DateTime?
  role        Role        @relation(fields: [roleId], references: [id])

  @@unique([accountId, roleId])
  @@index([accountId, scopeLevel, tenantId])
}

// ============================================================
// Navigation governance model
// ============================================================

model NavigationEntry {
  id                 String   @id @default(uuid())
  entryKey           String   @unique
  name               String
  description        String?
  featureKey         String?
  supportedTerminals Json
  registryPriority   Int      @default(0)
  enabled            Boolean  @default(true)
  entryType          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  roleVisibilities   RoleNavigationVisibility[]
  roleLandingPolicies RoleLandingPolicy[]

  @@index([featureKey, enabled])
}

model RoleNavigationVisibility {
  id         String @id @default(uuid())
  roleId     String
  entryKey   String
  terminal   String
  enabled    Boolean @default(true)

  role  Role            @relation(fields: [roleId], references: [id])
  entry NavigationEntry @relation(fields: [entryKey], references: [entryKey])

  @@unique([roleId, entryKey, terminal])
  @@index([roleId, terminal])
}

model RoleLandingPolicy {
  id              String  @id @default(uuid())
  roleId          String
  terminal        String
  defaultEntryKey String
  priority        Int     @default(0)
  enabled         Boolean @default(true)

  role  Role            @relation(fields: [roleId], references: [id])
  entry NavigationEntry @relation(fields: [defaultEntryKey], references: [entryKey])

  @@unique([roleId, terminal, defaultEntryKey])
  @@index([roleId, terminal])
}

// ============================================================
// ABAC policy model
// ============================================================

model Policy {
  id               String            @id @default(uuid())
  name             String
  description      String?
  tenantId         String? // null = global policy
  effect           PolicyEffect
  subjectType      PolicySubjectType @default(ANY)
  subjectId        String? // ROLE uses roleCode, ACCOUNT uses accountId
  permissionCode   String // always bound to a permission
  permission       Permission        @relation(fields: [permissionCode], references: [code])
  resourceType     String? // null = applies to all resource types
  priority         Int               @default(0)
  isEnabled        Boolean           @default(true)
  conditionAstJson String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([tenantId, isEnabled])
  @@index([permissionCode, isEnabled])
  @@index([subjectType, subjectId])
}

model AuditEvent {
  id           String   @id
  service      String
  module       String
  eventType    String
  occurredAt   DateTime
  result       String
  operatorId   String?
  operatorType String
  tenantId     String?
  orgId        String?
  traceId      String?
  resourceType String
  resourceId   String?
  details      Json
  createdAt    DateTime @default(now())

  @@index([service, module, eventType, occurredAt])
  @@index([tenantId, occurredAt])
  @@index([operatorId, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
}

model DecisionEvent {
  id                String                @id @default(uuid())
  tenantId          String?
  accountId         String
  permissionCode    String
  resourceType      String?
  resourceId        String?
  evaluationMode    EvaluationMode
  decision          AuthorizationDecision
  matchedPolicyId   String?
  matchedPolicyName String?
  reason            String?
  requestContext    Json?
  createdAt         DateTime              @default(now())

  @@index([accountId, createdAt])
  @@index([permissionCode, createdAt])
  @@index([tenantId, createdAt])
}

// ============================================================
// Enums
// ============================================================

enum Modules {
  ENTITY_SERVICE
  IDENTITY_SERVICE
  PERMISSION_SERVICE
  AUTH_SERVICE
  EPR_SERVICE
  MES_SERVICE
  WMS_SERVICE
}

enum AccountType {
  USER
  SERVICE
}

enum RoleKind {
  SYSTEM_TEMPLATE
  SYSTEM_INSTANCE
  TENANT_INSTANCE
}

enum ScopeLevel {
  SYSTEM
  TENANT
}

enum PolicyEffect {
  ALLOW
  DENY
}

enum PolicySubjectType {
  ROLE
  ACCOUNT
  ANY
}

enum EvaluationMode {
  RBAC
  RBAC_ABAC
}

enum AuthorizationDecision {
  ALLOW
  DENY
}
