// src/services/system/permission-service/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String? // 应用范围： 1. 租户内 2.null代表全平台可用
  code        String // 角色唯一代码，例如 "admin"
  name        String // 角色名称，例如 "管理员"
  description String?
  isSystem    Boolean  @default(false) // 是否为系统内置角色
  isEnabled   Boolean  @default(true) // 是否启用
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String // 创建者是谁：可以是租户管理员也可以是系统管理员。指向 identity-service 的 userAccount.id

  permissions RolePermission[]
  accounts    AccountRole[]

  @@unique([tenantId, code])
}

enum Modules {
  ENTITY_SERVICE
  IDENTITY_SERVICE
  PERMISSION_SERVICE
  AUTH_SERVICE
  EPR_SERVICE
  MES_SERVICE
  WMS_SERVICE
}

model Permission {
  id          String           @id @default(uuid())
  code        String // 权限代码，如 "order:read"
  description String?
  module      Modules
  roles       RolePermission[]

  @@unique([code])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdBy    String // 创建者是谁：可以是租户管理员也可以是系统管理员。指向 identity-service 的 userAccount.id

  @@unique([roleId, permissionId])
}

model AccountRole {
  id          String      @id @default(uuid())
  accountType AccountType
  accountId   String // 指向 identity-service 中 serviceAccount.id 或 userAccount.id
  roleId      String
  tenantId    String // 冗余字段，方便查询
  role        Role        @relation(fields: [roleId], references: [id])
  createdBy   String // 创建者是谁：可以是租户管理员也可以是系统管理员。指向 identity-service 的 userAccount.id

  @@unique([accountId, roleId])
  @@index([accountId, tenantId])
}

model AccountScope {
  id             String      @id @default(uuid())
  holderType     AccountType
  holderId       String // 指向identity-service 中 serviceAccount.id 或 userAccount.id
  tenantId       String // 指向identity-service 中 tenant.id
  isActive       Boolean     @default(true)
  permissionCode String
  resourceType   String
  resourceId     String
  expiredAt      DateTime?
  createdBy      String // 创建者是谁：可以是租户管理员也可以是系统管理员。指向 identity-service 的 userAccount.id

  @@index([holderId, permissionCode])
  @@index([holderId, resourceType, resourceId])
  @@index([holderId, tenantId])
}

enum AccountType {
  USER
  SERVICE
}
