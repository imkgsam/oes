generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemStructureType {
  SINGLE
  BUNDLE
}

enum ItemNatureType {
  PHYSICAL
  VIRTUAL
  SERVICE
}

enum ItemStatus {
  ACTIVE
  INACTIVE
}

enum ItemCategoryStatus {
  ACTIVE
  INACTIVE
}

model Item {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @db.VarChar(64)
  itemCode          String                @db.VarChar(128)
  itemName          String                @db.VarChar(255)
  structureType     ItemStructureType
  natureType        ItemNatureType
  status            ItemStatus            @default(ACTIVE)
  primaryCategoryId String?               @db.Uuid
  sellable          Boolean               @default(false)
  purchasable       Boolean               @default(false)
  stockable         Boolean               @default(false)
  manufacturable    Boolean               @default(false)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  primaryCategory   ItemCategory?         @relation("ItemPrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: SetNull)
  parentLinks       ItemComposition[]     @relation("ItemCompositionParent")
  componentLinks    ItemComposition[]     @relation("ItemCompositionComponent")
  supplierMappings  SupplierItemMapping[]

  @@unique([tenantId, itemCode])
  @@index([tenantId, status])
  @@index([tenantId, structureType, natureType])
  @@index([tenantId, primaryCategoryId])
}

model ItemCategory {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @db.VarChar(64)
  categoryCode     String             @db.VarChar(128)
  categoryName     String             @db.VarChar(255)
  parentCategoryId String?            @db.Uuid
  status           ItemCategoryStatus @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  parent   ItemCategory?  @relation("ItemCategoryTree", fields: [parentCategoryId], references: [id], onDelete: Restrict)
  children ItemCategory[] @relation("ItemCategoryTree")
  items    Item[]         @relation("ItemPrimaryCategory")

  @@unique([tenantId, categoryCode])
  @@index([tenantId, parentCategoryId])
  @@index([tenantId, status])
}

model ItemComposition {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.VarChar(64)
  parentItemId    String   @db.Uuid
  componentItemId String   @db.Uuid
  sortOrder       Int
  createdAt       DateTime @default(now())

  parentItem    Item @relation("ItemCompositionParent", fields: [parentItemId], references: [id], onDelete: Cascade)
  componentItem Item @relation("ItemCompositionComponent", fields: [componentItemId], references: [id], onDelete: Restrict)

  @@unique([tenantId, parentItemId, componentItemId])
  @@index([tenantId, parentItemId, sortOrder])
}

model SupplierItemMapping {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @db.VarChar(64)
  supplierId          String   @db.VarChar(64)
  supplierItemCode    String?  @db.VarChar(255)
  supplierItemName    String?  @db.VarChar(255)
  supplierItemCodeKey String?  @db.VarChar(255)
  supplierItemNameKey String?  @db.VarChar(255)
  itemId              String   @db.Uuid
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([tenantId, supplierId, supplierItemCodeKey])
  @@unique([tenantId, supplierId, supplierItemNameKey])
  @@index([tenantId, supplierId])
}

model AuditEvent {
  id           String   @id
  service      String
  module       String
  eventType    String
  occurredAt   DateTime
  result       String
  operatorId   String?
  operatorType String
  tenantId     String?
  orgId        String?
  traceId      String?
  resourceType String
  resourceId   String?
  details      Json
  createdAt    DateTime @default(now())

  @@index([service, module, eventType, occurredAt])
  @@index([tenantId, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
}
