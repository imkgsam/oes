generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemModelKind {
  PHYSICAL
  SERVICE
  DIGITAL
  VIRTUAL
}

enum ItemModelType {
  FINISHED_PRODUCT
  SEMI_FINISHED_PRODUCT
  ACCESSORY
  PART
  SUB_ASSEMBLY
  RAW_MATERIAL
  PACKAGING_MATERIAL
  SERVICE
  VIRTUAL_KIT
}

enum ItemType {
  STANDARD
  PACKAGED_FINISHED_GOOD
}

enum BomType {
  COMPOSITION
  TRANSFORMATION
  PACKAGING
}

enum BomLineRole {
  PRIMARY_INPUT
  COMPONENT
  PACKAGING_MATERIAL
}

model ItemModel {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @db.VarChar(64)
  modelCode         String         @db.VarChar(128)
  modelName         String         @db.VarChar(255)
  modelKind         ItemModelKind
  modelType         ItemModelType
  active            Boolean        @default(true)
  sellable          Boolean        @default(false)
  purchasable       Boolean        @default(false)
  stockable         Boolean        @default(false)
  manufacturable    Boolean        @default(false)
  assemblable       Boolean        @default(false)
  transformable     Boolean        @default(false)
  packable          Boolean        @default(false)
  packaged          Boolean        @default(false)
  primaryCategoryId String?        @db.Uuid
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  primaryCategory ItemCategory?            @relation("ItemModelPrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: SetNull)
  items           Item[]
  attributeRules  ItemModelAttributeRule[]
  packagingSpecs  PackagingSpec[]

  @@unique([tenantId, modelCode])
  @@index([tenantId, active])
  @@index([tenantId, modelKind, modelType])
  @@index([tenantId, primaryCategoryId])
}

model AttributeDefinition {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @db.VarChar(64)
  attributeCode String            @db.VarChar(128)
  attributeName String            @db.VarChar(255)
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  options AttributeOption[]
  rules   ItemModelAttributeRule[]

  @@unique([tenantId, attributeCode])
  @@index([tenantId, active])
}

model AttributeOption {
  id                    String              @id @default(uuid()) @db.Uuid
  tenantId              String              @db.VarChar(64)
  attributeDefinitionId String              @db.Uuid
  optionCode            String              @db.VarChar(128)
  optionName            String              @db.VarChar(255)
  active                Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  attributeDefinition AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, attributeDefinitionId, optionCode])
  @@index([tenantId, active])
}

model ItemModelAttributeRule {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @db.VarChar(64)
  itemModelId           String   @db.Uuid
  attributeDefinitionId String   @db.Uuid
  required              Boolean  @default(false)
  allowedOptionIds      String[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  itemModel           ItemModel           @relation(fields: [itemModelId], references: [id], onDelete: Cascade)
  attributeDefinition AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Restrict)

  @@unique([tenantId, itemModelId, attributeDefinitionId])
  @@index([tenantId, itemModelId])
}

model Item {
  id                       String       @id @default(uuid()) @db.Uuid
  tenantId                 String       @db.VarChar(64)
  itemModelId              String       @db.Uuid
  itemCode                 String       @db.VarChar(128)
  itemName                 String       @db.VarChar(255)
  itemType                 ItemType
  lockedAttributeOptionIds String[]
  variantKey               String       @db.VarChar(1024)
  packagingSpecId          String?      @db.Uuid
  active                   Boolean      @default(true)
  sellable                 Boolean      @default(false)
  purchasable              Boolean      @default(false)
  stockable                Boolean      @default(false)
  manufacturable           Boolean      @default(false)
  assemblable              Boolean      @default(false)
  transformable            Boolean      @default(false)
  packable                 Boolean      @default(false)
  packaged                 Boolean      @default(false)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  itemModel        ItemModel             @relation(fields: [itemModelId], references: [id], onDelete: Restrict)
  packagingSpec    PackagingSpec?        @relation(fields: [packagingSpecId], references: [id], onDelete: Restrict)
  outputBoms       Bom[]                 @relation("BomOutputItem")
  componentBomLines BomLine[]            @relation("BomLineComponentItem")
  supplierMappings SupplierItemMapping[]

  @@unique([tenantId, itemCode])
  @@unique([tenantId, itemModelId, variantKey])
  @@index([tenantId, active])
  @@index([tenantId, itemModelId])
  @@index([tenantId, itemType])
  @@index([tenantId, packagingSpecId])
}

model ItemCategory {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @db.VarChar(64)
  categoryCode     String         @db.VarChar(128)
  categoryName     String         @db.VarChar(255)
  parentCategoryId String?        @db.Uuid
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  parent     ItemCategory?  @relation("ItemCategoryTree", fields: [parentCategoryId], references: [id], onDelete: Restrict)
  children   ItemCategory[] @relation("ItemCategoryTree")
  itemModels ItemModel[]    @relation("ItemModelPrimaryCategory")

  @@unique([tenantId, categoryCode])
  @@index([tenantId, parentCategoryId])
  @@index([tenantId, active])
}

model PackagingMethod {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.VarChar(64)
  methodCode String   @db.VarChar(128)
  methodName String   @db.VarChar(255)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  packagingSpecs PackagingSpec[]

  @@unique([tenantId, methodCode])
  @@index([tenantId, active])
}

model PackagingSpec {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.VarChar(64)
  itemModelId       String    @db.Uuid
  packagingMethodId String    @db.Uuid
  customerId        String?   @db.VarChar(64)
  specCode          String    @db.VarChar(128)
  specName          String    @db.VarChar(255)
  grossWeight       String?   @db.VarChar(64)
  volume            String?   @db.VarChar(64)
  outerLength       String?   @db.VarChar(64)
  outerWidth        String?   @db.VarChar(64)
  outerHeight       String?   @db.VarChar(64)
  workInstruction   String?
  version           String?   @db.VarChar(64)
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  itemModel       ItemModel       @relation(fields: [itemModelId], references: [id], onDelete: Restrict)
  packagingMethod PackagingMethod @relation(fields: [packagingMethodId], references: [id], onDelete: Restrict)
  items           Item[]

  @@unique([tenantId, specCode])
  @@index([tenantId, itemModelId])
  @@index([tenantId, packagingMethodId])
  @@index([tenantId, customerId])
  @@index([tenantId, active])
}

model Bom {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.VarChar(64)
  bomCode      String   @db.VarChar(128)
  bomName      String   @db.VarChar(255)
  bomType      BomType
  outputItemId String   @db.Uuid
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  outputItem Item      @relation("BomOutputItem", fields: [outputItemId], references: [id], onDelete: Restrict)
  lines      BomLine[]

  @@unique([tenantId, bomCode])
  @@index([tenantId, bomType])
  @@index([tenantId, outputItemId])
  @@index([tenantId, active])
}

model BomLine {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @db.VarChar(64)
  bomId           String      @db.Uuid
  componentItemId String      @db.Uuid
  lineRole        BomLineRole
  quantity        String      @db.VarChar(64)
  uomCode         String      @db.VarChar(64)
  lineNote        String?
  sortOrder       Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  bom           Bom  @relation(fields: [bomId], references: [id], onDelete: Cascade)
  componentItem Item @relation("BomLineComponentItem", fields: [componentItemId], references: [id], onDelete: Restrict)

  @@index([tenantId, bomId, sortOrder])
  @@index([tenantId, componentItemId])
}

model SupplierItemMapping {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @db.VarChar(64)
  supplierId          String   @db.VarChar(64)
  supplierItemCode    String?  @db.VarChar(255)
  supplierItemName    String?  @db.VarChar(255)
  supplierItemCodeKey String?  @db.VarChar(255)
  supplierItemNameKey String?  @db.VarChar(255)
  itemId              String   @db.Uuid
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([tenantId, supplierId, supplierItemCodeKey])
  @@unique([tenantId, supplierId, supplierItemNameKey])
  @@index([tenantId, supplierId])
  @@index([tenantId, itemId])
  @@index([tenantId, active])
}

model AuditEvent {
  id           String   @id
  service      String
  module       String
  eventType    String
  occurredAt   DateTime
  result       String
  operatorId   String?
  operatorType String
  tenantId     String?
  orgId        String?
  traceId      String?
  resourceType String
  resourceId   String?
  details      Json
  createdAt    DateTime @default(now())

  @@index([service, module, eventType, occurredAt])
  @@index([tenantId, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
}
