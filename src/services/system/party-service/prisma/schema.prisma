generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PartyType {
  PERSON
  ORGANIZATION
}

enum TenantPartyStatus {
  ACTIVE
  INACTIVE
}

enum IdentifierStatus {
  DECLARED
  VERIFIED
  INVALID
  EXPIRED
}

enum TenantPartyContactPointType {
  EMAIL
  PHONE
  WHATSAPP
  DOMAIN
  WEBSITE
}

model TenantParty {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @db.VarChar(64)
  type               PartyType
  legalName          String            @db.VarChar(255)
  displayName        String?           @db.VarChar(255)
  localCode          String?           @db.VarChar(100)
  registeredCountry  String?           @db.VarChar(50)
  tags               Json?
  status             TenantPartyStatus @default(ACTIVE)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  identifiers               TenantPartyIdentifier[]
  contactPoints             TenantPartyContactPoint[]
  registrationIdempotencies PartyRegistrationIdempotency[]

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, status])
  @@index([tenantId, legalName])
}

model TenantPartyContactPoint {
  id               String                      @id @default(uuid()) @db.Uuid
  tenantId         String                      @db.VarChar(64)
  tenantPartyId    String                      @db.Uuid
  contactPointType TenantPartyContactPointType
  normalizedValue  String                      @db.VarChar(255)
  rawValue         String                      @db.VarChar(255)
  label            String?                     @db.VarChar(100)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  tenantParty TenantParty @relation(fields: [tenantPartyId], references: [id], onDelete: Cascade)

  @@index([tenantId, contactPointType, normalizedValue])
  @@index([tenantId, tenantPartyId])
}

model TenantPartyIdentifier {
  id                    String           @id @default(uuid()) @db.Uuid
  tenantId              String           @db.VarChar(64)
  tenantPartyId         String           @db.Uuid
  identifierType        String           @db.VarChar(100)
  normalizedValue       String           @db.VarChar(255)
  rawValue              String           @db.VarChar(255)
  issuerCountryOrRegion String           @default("") @db.VarChar(50)
  status                IdentifierStatus @default(DECLARED)
  effectiveFrom         DateTime?
  effectiveTo           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  tenantParty TenantParty @relation(fields: [tenantPartyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, identifierType, issuerCountryOrRegion, normalizedValue])
  @@index([tenantId, tenantPartyId])
}

model PartyRegistrationIdempotency {
  id             String   @id @default(uuid()) @db.Uuid
  idempotencyKey String   @unique @db.VarChar(128)
  operation      String   @db.VarChar(80)
  requestHash    String   @db.VarChar(128)
  tenantPartyId  String   @db.Uuid
  matchResult    String?  @db.VarChar(80)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenantParty TenantParty @relation(fields: [tenantPartyId], references: [id], onDelete: Restrict)

  @@index([operation])
  @@index([tenantPartyId])
}
