generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CollaborationTaskVisibility {
  PRIVATE
  ASSIGNMENT_PARTICIPANTS
}

enum CollaborationTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CollaborationTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CollaborationTaskOutboxStatus {
  PENDING
  PUBLISHED
  QUARANTINED
}

enum CollaborationAnnotationVisibility {
  PRIVATE
  OBJECT_VISIBLE
}

model CollaborationTask {
  id                   String                      @id @default(uuid()) @db.Uuid
  tenantId             String                      @db.VarChar(100)
  title                String                      @db.VarChar(255)
  description          String?                     @db.VarChar(4000)
  createdByAccountId   String                      @db.VarChar(100)
  assigneeAccountId    String                      @db.VarChar(100)
  visibility           CollaborationTaskVisibility
  status               CollaborationTaskStatus     @default(OPEN)
  priority             CollaborationTaskPriority   @default(NORMAL)
  dueAt                DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  completedByAccountId String?                     @db.VarChar(100)
  completionNote       String?                     @db.VarChar(4000)
  cancelledAt          DateTime?
  cancelledByAccountId String?                     @db.VarChar(100)
  cancelReason         String?                     @db.VarChar(1000)
  archivedAt           DateTime?
  archivedByAccountId  String?                     @db.VarChar(100)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@index([tenantId, assigneeAccountId, status])
  @@index([tenantId, createdByAccountId, status])
  @@index([tenantId, dueAt])
  @@index([tenantId, archivedAt])
}

model CollaborationTaskAuditEnvelope {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.VarChar(100)
  taskId             String   @db.Uuid
  action             String   @db.VarChar(80)
  result             String   @db.VarChar(40)
  operatorAccountId  String   @db.VarChar(100)
  createdByAccountId String   @db.VarChar(100)
  assigneeAccountId  String   @db.VarChar(100)
  traceId            String?  @db.VarChar(100)
  auditId            String?  @db.VarChar(100)
  reasonSnapshot     String?  @db.VarChar(1000)
  occurredAt         DateTime @default(now())
  payload            Json?

  @@index([tenantId, taskId])
  @@index([tenantId, occurredAt])
}

model CollaborationTaskEventEnvelope {
  id                 String   @id @default(uuid()) @db.Uuid
  eventType          String   @db.VarChar(80)
  occurredAt         DateTime
  tenantId           String   @db.VarChar(100)
  taskId             String   @db.Uuid
  actorAccountId     String   @db.VarChar(100)
  createdByAccountId String   @db.VarChar(100)
  assigneeAccountId  String   @db.VarChar(100)
  status             String   @db.VarChar(40)
  previousStatus     String?  @db.VarChar(40)
  priority           String   @db.VarChar(40)
  dueAt              DateTime?
  titleSnapshot      String   @db.VarChar(255)
  traceId            String?  @db.VarChar(100)
  payload            Json
  publishedAt        DateTime @default(now())

  @@index([tenantId, taskId])
  @@index([tenantId, eventType, occurredAt])
  @@index([publishedAt])
}

model CollaborationTaskOutbox {
  eventId          String                       @id @db.Uuid
  eventType        String                       @db.VarChar(120)
  eventVersion     Int
  ownerService     String                       @db.VarChar(80)
  tenantId         String                       @db.VarChar(100)
  aggregateType    String                       @db.VarChar(80)
  aggregateId      String                       @db.Uuid
  occurredAt       DateTime
  cloudEventBody   Json
  status           CollaborationTaskOutboxStatus @default(PENDING)
  attemptCount     Int                          @default(0)
  nextAttemptAt    DateTime                     @default(now())
  leaseToken       String?                      @db.Uuid
  leaseExpiresAt   DateTime?
  lastErrorCode    String?                      @db.VarChar(120)
  lastErrorMessage String?                      @db.VarChar(1000)
  publishedAt      DateTime?
  quarantinedAt    DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@index([status, nextAttemptAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@index([leaseExpiresAt])
}

model CollaborationTaskCommandReceipt {
  id                             String   @id @default(uuid()) @db.Uuid
  tenantId                       String   @db.VarChar(100)
  operatorAccountId              String   @db.VarChar(100)
  operationKey                   String   @db.VarChar(180)
  idempotencyKey                 String   @db.VarChar(180)
  descriptorDigest               String   @db.VarChar(43)
  actionGrantJti                 String?  @unique @db.Uuid
  taskId                         String   @db.Uuid
  resultReference                String   @db.VarChar(100)
  delegationReference            String   @db.VarChar(100)
  agentPrincipalId               String   @db.VarChar(100)
  toolContractId                 String   @db.VarChar(180)
  toolContractVersion            String   @db.VarChar(40)
  authorizationDecisionReference String   @db.VarChar(100)
  consumedAt                     DateTime @default(now())
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  @@unique([tenantId, operatorAccountId, operationKey, idempotencyKey], map: "collab_task_receipt_idempotency_key")
  @@index([tenantId, taskId])
}

model CollaborationAnnotation {
  id                        String                            @id @default(uuid()) @db.Uuid
  tenantId                  String                            @db.VarChar(100)
  objectOwnerService        String                            @db.VarChar(80)
  objectType                String                            @db.VarChar(80)
  objectId                  String                            @db.VarChar(100)
  objectDisplayTitle        String?                           @db.VarChar(255)
  objectDisplaySubtitle     String?                           @db.VarChar(255)
  objectDisplayStatus       String?                           @db.VarChar(80)
  authorAccountId           String                            @db.VarChar(100)
  authorDisplayNameSnapshot String                            @db.VarChar(255)
  bodyText                  String                            @db.VarChar(4000)
  visibility                CollaborationAnnotationVisibility @default(OBJECT_VISIBLE)
  pinned                    Boolean                           @default(false)
  edited                    Boolean                           @default(false)
  deletedAt                 DateTime?
  deletedByAccountId        String?                           @db.VarChar(100)
  deleteReason              String?                           @db.VarChar(1000)
  createdAt                 DateTime                          @default(now())
  updatedAt                 DateTime                          @updatedAt

  @@index([tenantId, objectOwnerService, objectType, objectId, deletedAt], map: "collab_annotation_object_visible_idx")
  @@index([tenantId, objectOwnerService, objectType, objectId, pinned, createdAt], map: "collab_annotation_object_sort_idx")
  @@index([tenantId, authorAccountId, createdAt])
}

model CollaborationAnnotationAuditEnvelope {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.VarChar(100)
  annotationId       String   @db.Uuid
  action             String   @db.VarChar(80)
  result             String   @db.VarChar(40)
  operatorAccountId  String   @db.VarChar(100)
  authorAccountId    String   @db.VarChar(100)
  objectOwnerService String   @db.VarChar(80)
  objectType         String   @db.VarChar(80)
  objectId           String   @db.VarChar(100)
  traceId            String?  @db.VarChar(100)
  auditId            String?  @db.VarChar(100)
  reasonSnapshot     String?  @db.VarChar(1000)
  occurredAt         DateTime @default(now())
  payload            Json?

  @@index([tenantId, annotationId])
  @@index([tenantId, objectOwnerService, objectType, objectId])
  @@index([tenantId, occurredAt])
}
