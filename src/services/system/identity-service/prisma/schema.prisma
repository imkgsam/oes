generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity"]
}

model Party {
  id        String    @id @default(uuid()) // 实体 ID
  type      PartyType // 实体类型，个人还是公司
  legalname String // 实体法定名称
  alias     String? // 实体别名
  isActive  Boolean   @default(true) // 实体是否激活
  userId    String? // 关联的用户 ID（如果是个人）

  personInfo  PersonInfo?
  companyInfo CompanyInfo?

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("identity")
}

enum PartyType {
  PERSON
  COMPANY
}

model PersonInfo {
  id             String    @id @default(uuid()) // 个人信息 ID
  partyId        String    @unique // 关联的实体 ID
  IDNumber       String?   @unique // 身份证号码
  passportNumber String?   @unique // 护照号码
  birthday       DateTime?
  gender         Gender? // 性别

  party Party @relation(fields: [partyId], references: [id])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model CompanyInfo {
  id            String  @id @default(uuid()) // 公司信息 ID
  partyId       String  @unique // 关联的实体 ID
  industry      String? // 行业
  size          String? // 公司规模
  website       String? // 公司官网
  licenseNumber String? @unique // 营业执照号码
  taxID         String? @unique // 税务登记号码
  country       String? // 注册国家

  party Party @relation(fields: [partyId], references: [id])
}

model User {
  id        String   @id @default(uuid()) // 用户唯一 ID，例如 "usr_9d8f8a2f"
  email     String?  @unique // 用户个人邮箱，例如 "alice@example.com"
  phone     String?  @unique // 用户个人手机号，例如 "+8613800138000"
  fullname  String? // 用户姓名，例如 "Alice Zhang"
  createdAt DateTime @default(now()) // 创建时间
  updatedAt DateTime @updatedAt // 更新时间

  accounts Account[] // 一个用户可在多个租户中拥有账户

  @@schema("identity")
}

// 租户
model Tenant {
  id        String   @id @default(uuid())
  name      String //  例如 阿里巴巴集团
  code      String   @unique // 例如 alibaba
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) // 创建时间
  updatedAt DateTime @updatedAt // 更新时间

  accounts Account[] // 所有账户
  orgUnits Org[] // 所有组织结构节点

  @@schema("identity")
}

//组织，可以是公司，也可以是部门，也可以是小组...
model Org {
  id        String   @id @default(uuid())
  tenantId  String // 所属租户 ID
  parentId  String? // 上级组织 ID，可为空表示顶层
  name      String // 名称，如 "技术部"、"广州分公司"
  code      String? // 可选唯一编码，如 "TECH_GZ"
  type      String? // 类型，如 "department" | "branch" | "team"
  order     Int      @default(0) // 排序字段
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  parent   Org?   @relation("OrgToParent", fields: [parentId], references: [id])
  children Org[]  @relation("OrgToParent") // 子组织结构

  @@schema("identity")
}


