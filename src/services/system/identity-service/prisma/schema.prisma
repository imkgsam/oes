// src/services/system/identity-service/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  username     String?       @unique
  email        String?       @unique
  phone        String?       @unique
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userAccounts UserAccount[]
}

model UserAccount {
  id             String                     @id @default(uuid())
  tenantId       String?
  tenantPartyId  String?                    @db.Uuid
  userId         String
  scopeLevel     UserAccountScopeLevel      @default(TENANT)
  contextKey     String
  displayName    String?
  isEnable       Boolean                    @default(true)
  avatarUrl      String?
  avatarAssetId  String?
  bio            String?
  contactAssets  AccountContactAsset[]
  employeeBinding UserAccountEmployeeBinding?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  User           User                       @relation(fields: [userId], references: [id])

  @@unique([userId, scopeLevel, contextKey])
  @@index([scopeLevel])
  @@index([tenantId])
  @@index([tenantId, tenantPartyId])
}

model UserAccountEmployeeBinding {
  id         String      @id @default(uuid())
  tenantId   String
  accountId  String      @unique
  employeeId String      @unique
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  account    UserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

enum UserAccountScopeLevel {
  SYSTEM
  TENANT
}

model AccountContactAsset {
  id          String                       @id @default(uuid())
  tenantId    String
  accountId   String
  userId      String?
  employeeId  String?
  type        AccountContactAssetType
  provider    String?
  value       String
  displayName String?
  ownership   AccountContactAssetOwnership @default(COMPANY_CONTROLLED)
  usage       String[]                     @default([])
  status      AccountContactAssetStatus    @default(ACTIVE)
  isPrimary   Boolean                      @default(false)
  assignedAt  DateTime                     @default(now())
  releasedAt  DateTime?
  revokedAt   DateTime?
  assignedBy  String
  revokedBy   String?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  account     UserAccount                  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, type, status])
  @@index([tenantId, type, value])
  @@index([accountId, type, isPrimary])
  @@index([tenantId, accountId])
  @@index([employeeId])
}

enum AccountContactAssetType {
  WORK_EMAIL
  WORK_PHONE
  WECHAT
  WHATSAPP
  EXTERNAL_COMMUNICATION_ACCOUNT
  OTHER_SOCIAL
}

enum AccountContactAssetOwnership {
  COMPANY_CONTROLLED
  EMPLOYEE_OWNED
}

enum AccountContactAssetStatus {
  ACTIVE
  PENDING_HANDOVER
  DISABLED
  RELEASED
  REVOKED
}

model ServiceAccount {
  id          String                     @id @default(uuid())
  tenantId    String?
  scopeLevel  MachinePrincipalScopeLevel
  type        MachinePrincipalType
  name        String
  description String?
  status      MachinePrincipalStatus     @default(ACTIVE)
  apiKeys     APIKey[]
  machineWorkloadBindings MachineWorkloadBinding[]
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  createdBy   String?
  disabledAt  DateTime?
  disabledBy  String?

  @@index([tenantId])
  @@index([scopeLevel])
  @@index([type])
  @@index([status])
}

model MachineWorkloadBinding {
  id                 String   @id @default(uuid())
  serviceAccountId   String
  workloadSpiffeId   String
  idempotencyKey     String   @unique
  status             String   @default("ACTIVE")
  version            BigInt   @default(1)
  createdBy          String?
  disabledAt         DateTime?
  disabledBy         String?
  disableReasonCode  String?
  enrollmentAuditRef String   @unique
  disableAuditRef    String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  serviceAccount     ServiceAccount @relation(fields: [serviceAccountId], references: [id], onDelete: Restrict)
  enrollmentAudit    AuditEvent @relation("MachineWorkloadBindingEnrollmentAudit", fields: [enrollmentAuditRef], references: [eventId])
  disableAudit       AuditEvent? @relation("MachineWorkloadBindingDisableAudit", fields: [disableAuditRef], references: [eventId])

  @@index([serviceAccountId, status])
  @@index([workloadSpiffeId, status])
}

enum MachinePrincipalScopeLevel {
  SYSTEM
  TENANT
}

enum MachinePrincipalType {
  INTERNAL_SERVICE
  EXTERNAL_INTEGRATION
  AI_AGENT
  AUTOMATION_BOT
}

enum MachinePrincipalStatus {
  ACTIVE
  DISABLED
}

model APIKey {
  id               String       @id @default(uuid())
  serviceAccountId String
  keyCode          String       @unique
  hashedValue      String       @unique
  status           APIKeyStatus @default(ACTIVE)
  expiresAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  createdBy        String?
  revokedAt        DateTime?
  revokedBy        String?
  serviceAccount   ServiceAccount @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)

  @@index([serviceAccountId, status])
  @@index([expiresAt])
}

enum APIKeyStatus {
  ACTIVE
  REVOKED
}

model AuditEvent {
  eventId      String             @id
  service      String
  module       String
  eventType    String
  occurredAt   DateTime
  result       AuditEventResult
  operatorId   String?
  operatorType AuditOperatorType
  tenantId     String?
  orgId        String?
  traceId      String?
  resourceType String
  resourceId   String?
  details      Json
  createdAt    DateTime           @default(now())
  machineWorkloadBindingEnrollmentAudit MachineWorkloadBinding[] @relation("MachineWorkloadBindingEnrollmentAudit")
  machineWorkloadBindingDisableAudit    MachineWorkloadBinding[] @relation("MachineWorkloadBindingDisableAudit")

  @@index([service, occurredAt])
  @@index([module, occurredAt])
  @@index([eventType, occurredAt])
  @@index([tenantId, occurredAt])
  @@index([resourceType, resourceId])
}

enum AuditEventResult {
  SUCCEEDED
  REJECTED
  FAILED
}

enum AuditOperatorType {
  HUMAN
  SYSTEM
}
