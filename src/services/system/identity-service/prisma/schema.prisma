// src/services/system/identity-service/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  partyId      String?       @db.Uuid
  username     String?       @unique
  email        String?       @unique
  phone        String?       @unique
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userAccounts UserAccount[]

  @@index([partyId])
}

model UserAccount {
  id             String                     @id @default(uuid())
  tenantId       String?
  userId         String
  scopeLevel     UserAccountScopeLevel      @default(TENANT)
  contextKey     String
  displayName    String?
  isEnable       Boolean                    @default(true)
  avatarUrl      String?
  avatarAssetId  String?
  bio            String?
  contactAssets  AccountContactAsset[]
  employeeBinding UserAccountEmployeeBinding?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  User           User                       @relation(fields: [userId], references: [id])

  @@unique([userId, scopeLevel, contextKey])
  @@index([scopeLevel])
  @@index([tenantId])
}

model UserAccountEmployeeBinding {
  id         String      @id @default(uuid())
  tenantId   String
  accountId  String      @unique
  employeeId String      @unique
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  account    UserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

enum UserAccountScopeLevel {
  SYSTEM
  TENANT
}

model AccountContactAsset {
  id         String                    @id @default(uuid())
  tenantId   String
  accountId  String
  type       AccountContactAssetType
  value      String
  status     AccountContactAssetStatus @default(ACTIVE)
  isPrimary  Boolean                   @default(false)
  assignedAt DateTime                  @default(now())
  revokedAt  DateTime?
  assignedBy String
  revokedBy  String?
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt
  account    UserAccount               @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, type, status])
  @@index([tenantId, type, value])
  @@index([accountId, type, isPrimary])
}

enum AccountContactAssetType {
  WORK_EMAIL
  WORK_PHONE
}

enum AccountContactAssetStatus {
  ACTIVE
  DISABLED
  REVOKED
}

model ServiceAccount {
  id          String                     @id @default(uuid())
  tenantId    String?
  scopeLevel  MachinePrincipalScopeLevel
  type        MachinePrincipalType
  name        String
  description String?
  status      MachinePrincipalStatus     @default(ACTIVE)
  apiKeys     APIKey[]
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  createdBy   String?
  disabledAt  DateTime?
  disabledBy  String?

  @@index([tenantId])
  @@index([scopeLevel])
  @@index([type])
  @@index([status])
}

enum MachinePrincipalScopeLevel {
  SYSTEM
  TENANT
}

enum MachinePrincipalType {
  INTERNAL_SERVICE
  EXTERNAL_INTEGRATION
  AI_AGENT
  AUTOMATION_BOT
}

enum MachinePrincipalStatus {
  ACTIVE
  DISABLED
}

model APIKey {
  id               String       @id @default(uuid())
  serviceAccountId String
  keyCode          String       @unique
  hashedValue      String       @unique
  status           APIKeyStatus @default(ACTIVE)
  expiresAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  createdBy        String?
  revokedAt        DateTime?
  revokedBy        String?
  serviceAccount   ServiceAccount @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)

  @@index([serviceAccountId, status])
  @@index([expiresAt])
}

enum APIKeyStatus {
  ACTIVE
  REVOKED
}

model AuditEvent {
  eventId      String             @id
  service      String
  module       String
  eventType    String
  occurredAt   DateTime
  result       AuditEventResult
  operatorId   String?
  operatorType AuditOperatorType
  tenantId     String?
  orgId        String?
  traceId      String?
  resourceType String
  resourceId   String?
  details      Json
  createdAt    DateTime           @default(now())

  @@index([service, occurredAt])
  @@index([module, occurredAt])
  @@index([eventType, occurredAt])
  @@index([tenantId, occurredAt])
  @@index([resourceType, resourceId])
}

enum AuditEventResult {
  SUCCEEDED
  REJECTED
  FAILED
}

enum AuditOperatorType {
  HUMAN
  SYSTEM
}
