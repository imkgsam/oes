generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeLifecycleStatus {
  PREBOARDING
  ACTIVE
  OFFBOARDED
}

enum EmploymentStatus {
  ACTIVE
  ENDED
}

enum OnboardingAccessStatus {
  COMPLETED
  ACCOUNT_BINDING_PENDING
  ACCESS_GRANT_PENDING
}

model Employee {
  id              String                  @id @default(uuid()) @db.Uuid
  tenantId        String                  @db.VarChar(100)
  tenantPartyId   String                  @db.VarChar(100)
  partyId         String?                 @db.VarChar(100)
  employeeCode    String                  @db.VarChar(100)
  lifecycleStatus EmployeeLifecycleStatus @default(PREBOARDING)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  employments        Employment[]
  onboardingAccesses EmployeeOnboardingAccess[]

  @@unique([tenantId, tenantPartyId])
  @@unique([tenantId, employeeCode])
  @@index([tenantId])
}

model Employment {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.VarChar(100)
  employeeId    String           @db.Uuid
  orgUnitId     String           @db.VarChar(100)
  status        EmploymentStatus @default(ACTIVE)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  endedReason   String?          @db.VarChar(500)
  activeSlot    String?          @db.Uuid
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  employee           Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  onboardingAccesses EmployeeOnboardingAccess[]

  @@unique([tenantId, employeeId, activeSlot])
  @@index([tenantId, employeeId])
  @@index([tenantId, orgUnitId])
}

model EmployeeOnboardingAccess {
  id                  String                 @id @default(uuid()) @db.Uuid
  tenantId            String                 @db.VarChar(100)
  employeeId          String                 @db.Uuid
  employmentId        String                 @db.Uuid
  accountId           String?                @db.VarChar(100)
  status              OnboardingAccessStatus
  grantIdempotencyKey String?                @db.VarChar(200)
  failureReason       String?                @db.VarChar(1000)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employment Employment @relation(fields: [employmentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, employmentId])
  @@index([tenantId, status])
}
