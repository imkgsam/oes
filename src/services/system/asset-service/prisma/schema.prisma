generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Asset {
  id             String        @id @default(uuid())
  scopeLevel     AssetScopeLevel
  tenantId       String?
  ownerAccountId String?
  ownerEmployeeId String?
  activeEmployeeOfficialPhotoKey String? @unique
  category       AssetCategory
  storageKey     String        @unique
  mimeType       String
  size           BigInt
  checksum       String
  publicUrl      String
  status         AssetStatus   @default(PENDING_BIND)
  createdBy      String
  updatedBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([scopeLevel, tenantId, ownerAccountId, category, status])
  @@index([scopeLevel, tenantId, ownerEmployeeId, category, status])
}

enum AssetScopeLevel {
  SYSTEM
  TENANT
}

enum AssetCategory {
  ACCOUNT_AVATAR
  EMPLOYEE_OFFICIAL_PHOTO
}

enum AssetStatus {
  PENDING_BIND
  ACTIVE
  REPLACED
  DELETED
}
