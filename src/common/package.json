{
  "name": "@oes/common",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src/contracts"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w --preserveWatchOutput",
    "clear:build": "rimraf dist && rimraf tsconfig.tsbuildinfo",
    "clear:nm": "rimraf node_modules",
    "clear": "pnpm run clear:build && pnpm run clear:nm",
    "rebuild": "pnpm run clear:build && pnpm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./authorization": {
      "types": "./dist/authorization/index.d.ts",
      "require": "./dist/authorization/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "require": "./dist/auth/index.js"
    },
    "./clients": {
      "types": "./dist/clients/index.d.ts",
      "require": "./dist/clients/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "require": "./dist/config/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "require": "./dist/constants/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "require": "./dist/contracts/index.js"
    },
    "./cqrs": {
      "types": "./dist/cqrs/index.d.ts",
      "require": "./dist/cqrs/index.js"
    },
    "./decorators": {
      "types": "./dist/decorators/index.d.ts",
      "require": "./dist/decorators/index.js"
    },
    "./dtos": {
      "types": "./dist/dtos/index.d.ts",
      "require": "./dist/dtos/index.js"
    },
    "./exceptions": {
      "types": "./dist/core/exceptions/index.d.ts",
      "require": "./dist/core/exceptions/index.js"
    },
    "./filters": {
      "types": "./dist/core/filters/index.d.ts",
      "require": "./dist/core/filters/index.js"
    },
    "./generated/*": {
      "types": "./dist/generated/index.*.d.ts",
      "require": "./dist/generated/index.*.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "require": "./dist/interfaces/index.js"
    },
    "./logging": {
      "types": "./dist/logging/index.d.ts",
      "require": "./dist/logging/index.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "require": "./dist/registry/index.js"
    },
    "./tracing": {
      "types": "./dist/tracing/index.d.ts",
      "require": "./dist/tracing/index.js"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "require": "./dist/transport/index.js"
    }
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.1.3",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "rxjs": "^7.8.2"
  }
}
