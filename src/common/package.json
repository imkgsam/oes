{
  "name": "@oes/common",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "./src",
  "scripts": {
    "clear:build": "rimraf dist && rimraf tsconfig.tsbuildinfo",
    "clear:nm": "rimraf node_modules",
    "build": "tsc -b"
  },
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "require": "./dist/*.js"
    },
    "./generated/*": {
      "types": "./src/generated/*.ts",
      "require": "./dist/generated/*.js"
    }
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.1.3",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "rxjs": "^7.8.2"
  }
}
