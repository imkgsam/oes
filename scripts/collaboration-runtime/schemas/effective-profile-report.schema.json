{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oes.local/schemas/collaboration-runtime/effective-profile-report-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "ownerTaskId",
    "transitionId",
    "expectedState",
    "declaredCapabilities",
    "profile",
    "observations",
    "credentialReference",
    "telemetry"
  ],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "kind": { "const": "OES_EFFECTIVE_PROFILE_REPORT" },
    "ownerTaskId": { "type": "string", "minLength": 1 },
    "transitionId": { "type": "string", "minLength": 1 },
    "expectedState": { "enum": ["HANDOFF_PENDING", "DELIVERY_ACTIVE"] },
    "declaredCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "permission", "path", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "permission": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command",
          "literalOutput",
          "exitCode",
          "result",
          "evidencePath",
          "evidenceSha256"
        ],
        "properties": {
          "name": { "$ref": "#/$defs/capability" },
          "command": { "type": "string", "minLength": 1 },
          "literalOutput": { "type": "string" },
          "exitCode": { "const": 0 },
          "result": { "const": "PASS" },
          "evidencePath": { "type": "string", "pattern": "^/" },
          "evidenceSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "credentialReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "keys", "secretValuesRecorded"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "keys": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 2,
          "contains": { "const": "username" },
          "items": { "enum": ["username", "password"] }
        },
        "secretValuesRecorded": { "const": false }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventSource",
        "eventSourceSha256",
        "approvalPolicy",
        "approvalsReviewer",
        "approvalEventCount",
        "normalPermissionPromptCount"
      ],
      "properties": {
        "eventSource": { "type": "string", "pattern": "^/" },
        "eventSourceSha256": { "$ref": "#/$defs/sha256" },
        "eventSourceFingerprint": { "$ref": "#/$defs/sha256" },
        "snapshotRecord": { "$ref": "#/$defs/reference" },
        "probeAttemptId": { "type": "string", "minLength": 8 },
        "probeDraftFingerprint": { "$ref": "#/$defs/sha256" },
        "probeRequestFingerprint": { "$ref": "#/$defs/sha256" },
        "rolloutSessionId": { "type": "string", "minLength": 1 },
        "completedTurnId": { "type": "string", "minLength": 1 },
        "approvalPolicy": { "enum": ["on-request", "never"] },
        "approvalsReviewer": { "enum": ["auto_review", "user"] },
        "approvalEventCount": { "type": "integer", "minimum": 0 },
        "normalPermissionPromptCount": { "const": 0 },
        "approvalMode": { "$ref": "#/$defs/approvalMode" },
        "effectivePermissionSandboxFingerprint": { "$ref": "#/$defs/sha256" },
        "contexts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ordinal",
              "turnId",
              "approvalPolicy",
              "approvalsReviewer",
              "permissionProfileType",
              "sandboxPolicyType",
              "fileSystemSandboxPolicyKind",
              "activePermissionProfileId",
              "permissionSandboxFingerprint"
            ],
            "properties": {
              "ordinal": { "type": "integer", "minimum": 0 },
              "turnId": { "type": "string", "minLength": 1 },
              "approvalPolicy": { "enum": ["on-request", "never"] },
              "approvalsReviewer": { "enum": ["auto_review", "user"] },
              "permissionProfileType": { "type": "string", "minLength": 1 },
              "sandboxPolicyType": { "type": "string", "minLength": 1 },
              "fileSystemSandboxPolicyKind": { "const": "restricted" },
              "activePermissionProfileId": { "type": ["string", "null"] },
              "permissionSandboxFingerprint": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "resourceTopology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceTopologyVersion", "ownerResourceBinding"],
      "properties": {
        "resourceTopologyVersion": { "enum": ["pre-cutover-v1", "stable-owner-exclusive-v1"] },
        "ownerResourceBinding": {
          "type": ["object", "null"],
          "allOf": [{ "if": { "type": "object" }, "then": { "$ref": "#/$defs/reference" } }]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "resourceTopologyVersion": { "const": "stable-owner-exclusive-v1" } }
          },
          "then": { "properties": { "ownerResourceBinding": { "$ref": "#/$defs/reference" } } }
        },
        {
          "if": { "properties": { "resourceTopologyVersion": { "const": "pre-cutover-v1" } } },
          "then": { "properties": { "ownerResourceBinding": { "const": null } } }
        }
      ]
    },
    "approvalMode": { "$ref": "#/$defs/approvalMode" },
    "launchReceipt": { "$ref": "#/$defs/reference" },
    "effectivePermissionSandboxFingerprint": { "$ref": "#/$defs/sha256" },
    "probeAttempt": { "$ref": "#/$defs/reference" }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": 1 } } },
      "then": {
        "allOf": [
          { "not": { "required": ["approvalMode"] } },
          { "not": { "required": ["launchReceipt"] } },
          { "not": { "required": ["effectivePermissionSandboxFingerprint"] } },
          { "not": { "required": ["probeAttempt"] } }
        ],
        "properties": {
          "telemetry": {
            "allOf": [
              { "not": { "required": ["approvalMode"] } },
              { "not": { "required": ["effectivePermissionSandboxFingerprint"] } },
              { "not": { "required": ["eventSourceFingerprint"] } },
              { "not": { "required": ["contexts"] } },
              { "not": { "required": ["snapshotRecord"] } },
              { "not": { "required": ["probeAttemptId"] } },
              { "not": { "required": ["probeDraftFingerprint"] } },
              { "not": { "required": ["probeRequestFingerprint"] } },
              { "not": { "required": ["rolloutSessionId"] } },
              { "not": { "required": ["completedTurnId"] } }
            ],
            "properties": {
              "approvalPolicy": { "const": "on-request" },
              "approvalsReviewer": { "const": "auto_review" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "schemaVersion": { "const": 2 } } },
      "then": {
        "required": [
          "approvalMode",
          "launchReceipt",
          "effectivePermissionSandboxFingerprint",
          "resourceTopology",
          "probeAttempt"
        ],
        "properties": {
          "telemetry": {
            "required": [
              "approvalMode",
              "effectivePermissionSandboxFingerprint",
              "eventSourceFingerprint",
              "contexts",
              "snapshotRecord",
              "probeAttemptId",
              "probeDraftFingerprint",
              "probeRequestFingerprint",
              "rolloutSessionId",
              "completedTurnId"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": ["approvalMode"],
        "properties": { "approvalMode": { "const": "ON_REQUEST_AUTO_REVIEW" } }
      },
      "then": {
        "properties": {
          "telemetry": {
            "properties": {
              "approvalMode": { "const": "ON_REQUEST_AUTO_REVIEW" },
              "approvalPolicy": { "const": "on-request" },
              "approvalsReviewer": { "const": "auto_review" }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["approvalMode"],
        "properties": { "approvalMode": { "const": "NEVER_USER" } }
      },
      "then": {
        "properties": {
          "telemetry": {
            "properties": {
              "approvalMode": { "const": "NEVER_USER" },
              "approvalPolicy": { "const": "never" },
              "approvalsReviewer": { "const": "user" },
              "approvalEventCount": { "const": 0 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "approvalMode": { "enum": ["ON_REQUEST_AUTO_REVIEW", "NEVER_USER"] },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "fingerprint"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "fingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "capability": {
      "enum": [
        "filesystemWrite",
        "gitSwitchAddCommit",
        "standardBuildTest",
        "taskOwnedDatabase",
        "localhostBind",
        "approvedNetworkRead",
        "credentialReference",
        "approvalTelemetry"
      ]
    }
  }
}
