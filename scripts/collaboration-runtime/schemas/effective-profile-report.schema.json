{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oes.local/schemas/collaboration-runtime/effective-profile-report-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "ownerTaskId",
    "transitionId",
    "expectedState",
    "declaredCapabilities",
    "profile",
    "observations",
    "credentialReference",
    "telemetry"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "OES_EFFECTIVE_PROFILE_REPORT" },
    "ownerTaskId": { "type": "string" },
    "transitionId": { "type": "string" },
    "expectedState": { "enum": ["HANDOFF_PENDING", "DELIVERY_ACTIVE"] },
    "declaredCapabilities": { "type": "array", "uniqueItems": true },
    "profile": { "type": "object" },
    "observations": { "type": "array" },
    "credentialReference": { "type": "object" },
    "telemetry": {
      "type": "object",
      "required": ["approvalPolicy", "approvalsReviewer", "normalPermissionPromptCount"],
      "properties": {
        "approvalPolicy": { "const": "on-request" },
        "approvalsReviewer": { "const": "auto_review" },
        "normalPermissionPromptCount": { "const": 0 }
      }
    }
  }
}
