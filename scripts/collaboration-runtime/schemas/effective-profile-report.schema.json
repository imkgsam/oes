{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oes.local/schemas/collaboration-runtime/effective-profile-report-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "ownerTaskId",
    "transitionId",
    "expectedState",
    "declaredCapabilities",
    "profile",
    "observations",
    "credentialReference",
    "telemetry"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "OES_EFFECTIVE_PROFILE_REPORT"
    },
    "ownerTaskId": {
      "type": "string",
      "minLength": 1
    },
    "transitionId": {
      "type": "string",
      "minLength": 1
    },
    "expectedState": {
      "enum": ["HANDOFF_PENDING", "DELIVERY_ACTIVE"]
    },
    "declaredCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "permission", "path", "sha256"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "permission": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command",
          "literalOutput",
          "exitCode",
          "result",
          "evidencePath",
          "evidenceSha256"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/capability"
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "literalOutput": {
            "type": "string"
          },
          "exitCode": {
            "const": 0
          },
          "result": {
            "const": "PASS"
          },
          "evidencePath": {
            "type": "string",
            "pattern": "^/"
          },
          "evidenceSha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "credentialReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "keys", "secretValuesRecorded"],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "keys": {
          "type": "array",
          "uniqueItems": true,
          "contains": {
            "const": "username"
          },
          "items": {
            "enum": ["username", "password"]
          },
          "minItems": 2
        },
        "secretValuesRecorded": {
          "const": false
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventSource",
        "eventSourceSha256",
        "approvalPolicy",
        "approvalsReviewer",
        "approvalEventCount",
        "normalPermissionPromptCount"
      ],
      "properties": {
        "eventSource": {
          "type": "string",
          "pattern": "^/"
        },
        "eventSourceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "approvalPolicy": {
          "const": "on-request"
        },
        "approvalsReviewer": {
          "const": "auto_review"
        },
        "approvalEventCount": {
          "type": "integer",
          "minimum": 0
        },
        "normalPermissionPromptCount": {
          "const": 0
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capability": {
      "enum": [
        "filesystemWrite",
        "gitSwitchAddCommit",
        "standardBuildTest",
        "taskOwnedDatabase",
        "localhostBind",
        "approvedNetworkRead",
        "credentialReference",
        "approvalTelemetry"
      ]
    }
  }
}
