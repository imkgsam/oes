{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oes.local/schemas/collaboration-runtime/stage-lifecycle-inventory-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "inventoryFingerprint",
    "stageKey",
    "stageOwnerTaskId",
    "transitionId",
    "stageCleanupAuthorizationFingerprint",
    "cleanupIntentDetected",
    "stageExit",
    "resourceCleanup",
    "rosterAuthorityFingerprint",
    "taskReadbackSource",
    "readbackRosterFingerprint",
    "readbackRoster",
    "terminalTaskIds"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "OES_STAGE_LIFECYCLE_INVENTORY" },
    "inventoryFingerprint": { "$ref": "#/$defs/sha256" },
    "stageKey": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "stageOwnerTaskId": { "type": "string", "minLength": 1 },
    "transitionId": { "type": "string", "minLength": 1 },
    "stageCleanupAuthorizationFingerprint": { "$ref": "#/$defs/sha256" },
    "cleanupIntentDetected": { "const": true },
    "stageExit": { "enum": ["PASSED", "PENDING", "FAILED"] },
    "resourceCleanup": { "enum": ["PENDING", "VERIFIED", "PARTIAL_FAILURE"] },
    "rosterAuthorityFingerprint": { "$ref": "#/$defs/sha256" },
    "taskReadbackSource": { "const": "CODEX_TASK_NATIVE" },
    "readbackRosterFingerprint": { "$ref": "#/$defs/sha256" },
    "readbackRoster": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    },
    "terminalTaskIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "role", "ownerTaskId", "state"],
      "properties": {
        "taskId": { "type": "string", "minLength": 1 },
        "role": {
          "enum": ["IT", "FEATURE_RI", "FL", "STAGE_DESIGN", "STAGE_RI", "SL", "GLOBAL_UD"]
        },
        "ownerTaskId": { "type": ["string", "null"], "minLength": 1 },
        "state": { "enum": ["TERMINAL", "ACTIVE", "UNKNOWN"] }
      }
    }
  }
}
