{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oes.local/schemas/collaboration-runtime/coordination-archive-result-set-v2.json",
  "title": "OES V2 CO child-first archive result set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "resultSetFingerprint",
    "coordinationKey",
    "coordinationOwnerTaskId",
    "transitionId",
    "coordinationCleanupAuthorizationFingerprint",
    "inventoryFingerprint",
    "results"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "OES_COORDINATION_ARCHIVE_RESULT_SET" },
    "resultSetFingerprint": { "$ref": "#/$defs/sha256" },
    "coordinationKey": { "$ref": "#/$defs/key" },
    "coordinationOwnerTaskId": { "$ref": "#/$defs/token" },
    "transitionId": { "$ref": "#/$defs/token" },
    "coordinationCleanupAuthorizationFingerprint": { "$ref": "#/$defs/sha256" },
    "inventoryFingerprint": { "$ref": "#/$defs/sha256" },
    "results": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/result" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "token": { "type": "string", "minLength": 1 },
    "taskKind": { "enum": ["BOUNDED_HELPER", "RV", "DO", "CO"] },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "taskKind",
        "state",
        "inventoryFingerprint",
        "taskNativeReadbackFingerprint",
        "resultFingerprint"
      ],
      "properties": {
        "taskId": { "$ref": "#/$defs/token" },
        "taskKind": { "$ref": "#/$defs/taskKind" },
        "state": { "enum": ["ARCHIVED", "FAILED"] },
        "inventoryFingerprint": { "$ref": "#/$defs/sha256" },
        "taskNativeReadbackFingerprint": { "$ref": "#/$defs/sha256" },
        "resultFingerprint": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
