{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oes.local/schemas/assignment-runtime-state.schema.json",
  "title": "OES persisted assignment runtime state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "recordFingerprint",
    "owner",
    "coordinationKey",
    "deliveryKey",
    "transitionId",
    "scopeFingerprint",
    "stateVersion",
    "status",
    "ceiling",
    "activeAssignments",
    "resultTombstones",
    "wip",
    "deliveryTopology",
    "nextLegalAction"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "OES_ASSIGNMENT_RUNTIME_STATE" },
    "recordFingerprint": { "$ref": "#/$defs/fingerprint" },
    "owner": { "$ref": "#/$defs/owner" },
    "coordinationKey": { "$ref": "#/$defs/deliveryKey" },
    "deliveryKey": { "$ref": "#/$defs/deliveryKey" },
    "transitionId": { "$ref": "#/$defs/token" },
    "scopeFingerprint": { "$ref": "#/$defs/fingerprint" },
    "stateVersion": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["ACTIVE", "WAITING_ON_CHILD", "DELIVERY_TOPOLOGY_REQUIRED"] },
    "ceiling": { "$ref": "#/$defs/ceiling" },
    "activeAssignments": {
      "type": "array",
      "items": { "$ref": "#/$defs/activeAssignment" },
      "uniqueItems": true
    },
    "resultTombstones": {
      "type": "array",
      "items": { "$ref": "#/$defs/resultTombstone" },
      "uniqueItems": true
    },
    "wip": { "$ref": "#/$defs/wip" },
    "deliveryTopology": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["decision", "requestFingerprint", "decisionFingerprint"],
      "properties": {
        "decision": { "enum": ["DELIVERY_TOPOLOGY_REQUIRED", "ATOMIC_CONTINUATION"] },
        "requestFingerprint": { "$ref": "#/$defs/fingerprint" },
        "decisionFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "nextLegalAction": { "$ref": "#/$defs/action" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "WAITING_ON_CHILD" } } },
      "then": { "properties": { "activeAssignments": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "status": { "const": "ACTIVE" } } },
      "then": { "properties": { "activeAssignments": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "status": { "const": "DELIVERY_TOPOLOGY_REQUIRED" } } },
      "then": {
        "properties": {
          "deliveryTopology": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decision", "requestFingerprint", "decisionFingerprint"],
            "properties": {
              "decision": { "const": "DELIVERY_TOPOLOGY_REQUIRED" },
              "requestFingerprint": { "$ref": "#/$defs/fingerprint" },
              "decisionFingerprint": { "$ref": "#/$defs/fingerprint" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "deliveryKey": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "token": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" },
    "action": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "taskId", "parentTaskId"],
      "properties": {
        "role": { "enum": ["CO", "DO"] },
        "taskId": { "$ref": "#/$defs/token" },
        "parentTaskId": { "$ref": "#/$defs/token" }
      }
    },
    "ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxActiveDeliveryOwners",
        "maxActiveBoundedHelpersPerDelivery",
        "maxActiveReviewVerifiersPerDelivery"
      ],
      "properties": {
        "maxActiveDeliveryOwners": { "enum": [1, 2, 3] },
        "maxActiveBoundedHelpersPerDelivery": { "enum": [1, 2, 3] },
        "maxActiveReviewVerifiersPerDelivery": { "const": 1 }
      }
    },
    "activeAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignmentId",
        "requestFingerprint",
        "parentTaskId",
        "childTaskId",
        "childKind",
        "deliveryKey",
        "transitionId",
        "dispatchStateVersion",
        "expectedTypedResult",
        "nextLegalActionOnResult",
        "scopeFingerprint",
        "resultArtifactRoot",
        "resultArtifactRootIdentity"
      ],
      "properties": {
        "assignmentId": { "$ref": "#/$defs/fingerprint" },
        "requestFingerprint": { "$ref": "#/$defs/fingerprint" },
        "parentTaskId": { "$ref": "#/$defs/token" },
        "childTaskId": { "$ref": "#/$defs/token" },
        "childKind": { "enum": ["DO", "BOUNDED_HELPER", "RV"] },
        "deliveryKey": { "$ref": "#/$defs/deliveryKey" },
        "transitionId": { "$ref": "#/$defs/token" },
        "dispatchStateVersion": { "type": "integer", "minimum": 1 },
        "expectedTypedResult": { "$ref": "#/$defs/token" },
        "nextLegalActionOnResult": { "$ref": "#/$defs/action" },
        "scopeFingerprint": { "$ref": "#/$defs/fingerprint" },
        "resultArtifactRoot": { "$ref": "#/$defs/absolutePath" },
        "resultArtifactRootIdentity": { "$ref": "#/$defs/resultArtifactRootIdentity" }
      }
    },
    "resultArtifactRootIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physicalPath", "device", "inode", "fileType"],
      "properties": {
        "physicalPath": { "$ref": "#/$defs/absolutePath" },
        "device": { "$ref": "#/$defs/unsignedInteger" },
        "inode": { "$ref": "#/$defs/unsignedInteger" },
        "fileType": { "const": "DIRECTORY" }
      }
    },
    "deliveryWip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deliveryKey", "activeBoundedHelpers", "activeReviewVerifiers"],
      "properties": {
        "deliveryKey": { "$ref": "#/$defs/deliveryKey" },
        "activeBoundedHelpers": { "type": "integer", "minimum": 0 },
        "activeReviewVerifiers": { "type": "integer", "minimum": 0 }
      }
    },
    "wip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeDeliveryOwners", "deliveries"],
      "properties": {
        "activeDeliveryOwners": { "type": "integer", "minimum": 0 },
        "deliveries": {
          "type": "array",
          "items": { "$ref": "#/$defs/deliveryWip" },
          "uniqueItems": true
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "assignmentId",
        "resultFingerprint",
        "appliedStateVersion",
        "remainingAssignments",
        "wip",
        "nextLegalAction"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "OES_ASSIGNMENT_RESULT_RECEIPT" },
        "assignmentId": { "$ref": "#/$defs/fingerprint" },
        "resultFingerprint": { "$ref": "#/$defs/fingerprint" },
        "appliedStateVersion": { "type": "integer", "minimum": 1 },
        "remainingAssignments": { "type": "integer", "minimum": 0 },
        "wip": { "$ref": "#/$defs/wip" },
        "nextLegalAction": { "$ref": "#/$defs/action" }
      }
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/(?!.*(?:^|/)\\.\\.?(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "unsignedInteger": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)$"
    },
    "resultTombstone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignment", "resultFingerprint", "receipt"],
      "properties": {
        "assignment": { "$ref": "#/$defs/activeAssignment" },
        "resultFingerprint": { "$ref": "#/$defs/fingerprint" },
        "receipt": { "$ref": "#/$defs/receipt" }
      }
    }
  }
}
