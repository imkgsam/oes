{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oes.local/schemas/collaboration-runtime/ci-rerun-receipt-v1.json",
  "title": "OES CI Failed Job Rerun Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "receiptFingerprint",
    "idempotencyKey",
    "candidateSha",
    "workflowRunId",
    "failedJobId",
    "action"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "OES_CI_FAILED_JOB_RERUN_RECEIPT" },
    "receiptFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "idempotencyKey": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "candidateSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "workflowRunId": { "type": "string", "minLength": 1 },
    "failedJobId": { "type": "string", "minLength": 1 },
    "action": { "const": "RERUN_FAILED_JOB_ONCE" }
  }
}
