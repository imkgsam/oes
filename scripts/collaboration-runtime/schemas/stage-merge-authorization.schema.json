{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oes.local/schemas/collaboration-runtime/stage-merge-authorization-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "authorizationFingerprint",
    "status",
    "expectedState",
    "stateVersion",
    "stageKey",
    "stageOwnerTaskId",
    "transitionId",
    "confirmationFingerprint",
    "stageScopeFingerprint",
    "stageRiskFingerprint",
    "orderedSetFingerprint",
    "stageRi",
    "stopPoint",
    "items"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "OES_STAGE_MERGE_AUTHORIZATION" },
    "authorizationFingerprint": { "$ref": "#/$defs/sha256" },
    "status": { "const": "ISSUED" },
    "expectedState": { "const": "STAGE_MERGE_AUTHORIZED" },
    "stateVersion": { "type": "integer", "minimum": 1 },
    "stageKey": { "$ref": "#/$defs/key" },
    "stageOwnerTaskId": { "type": "string", "minLength": 1 },
    "transitionId": { "type": "string", "minLength": 1 },
    "confirmationFingerprint": { "$ref": "#/$defs/sha256" },
    "stageScopeFingerprint": { "$ref": "#/$defs/sha256" },
    "stageRiskFingerprint": { "$ref": "#/$defs/sha256" },
    "orderedSetFingerprint": { "$ref": "#/$defs/sha256" },
    "stageRi": { "const": "PASSED" },
    "stopPoint": { "const": "STOP_SAME_STAGE_SUFFIX_ON_FAILURE" },
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "featureKey",
        "ownerTaskId",
        "pullRequestNumber",
        "integrationBase",
        "candidateSha",
        "patchFingerprint",
        "contentFingerprint",
        "scopeFingerprint",
        "riskFingerprint",
        "requiredChecks",
        "featureRi"
      ],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "featureKey": { "$ref": "#/$defs/key" },
        "ownerTaskId": { "type": "string", "minLength": 1 },
        "pullRequestNumber": { "type": "integer", "minimum": 1 },
        "integrationBase": { "$ref": "#/$defs/gitSha" },
        "candidateSha": { "$ref": "#/$defs/gitSha" },
        "patchFingerprint": { "$ref": "#/$defs/sha256" },
        "contentFingerprint": { "$ref": "#/$defs/sha256" },
        "scopeFingerprint": { "$ref": "#/$defs/sha256" },
        "riskFingerprint": { "$ref": "#/$defs/sha256" },
        "requiredChecks": { "const": ["Baseline Checks"] },
        "featureRi": { "const": "PASSED" }
      }
    }
  }
}
