{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oes.local/schemas/collaboration-runtime/local-main-sync-binding-v1.json",
  "title": "OES Local Main Sync Binding V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "bindingFingerprint",
    "action",
    "repositoryRoot",
    "remote",
    "branch",
    "expectedRemoteUrl",
    "expectedRemoteMainSha",
    "ownerTaskId",
    "transitionId",
    "singleUseNonce",
    "humanConfirmationFingerprint",
    "confirmation"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "OES_LOCAL_MAIN_SYNC_BINDING" },
    "bindingFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "action": { "enum": ["inspect", "sync"] },
    "repositoryRoot": { "type": "string", "pattern": "^/" },
    "remote": { "const": "origin" },
    "branch": { "const": "main" },
    "expectedRemoteUrl": { "type": "string", "minLength": 1 },
    "expectedRemoteMainSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "ownerTaskId": { "type": ["string", "null"], "minLength": 1 },
    "transitionId": { "type": ["string", "null"], "minLength": 1 },
    "singleUseNonce": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "humanConfirmationFingerprint": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "confirmation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "sha256", "fingerprint"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "sync" } } },
      "then": {
        "properties": {
          "ownerTaskId": { "type": "string" },
          "transitionId": { "type": "string" },
          "singleUseNonce": { "type": "string" },
          "humanConfirmationFingerprint": { "type": "string" },
          "confirmation": { "type": "object" }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "inspect" } } },
      "then": {
        "properties": {
          "ownerTaskId": { "type": "null" },
          "transitionId": { "type": "null" },
          "singleUseNonce": { "type": "null" },
          "humanConfirmationFingerprint": { "type": "null" },
          "confirmation": { "type": "null" }
        }
      }
    }
  ]
}
