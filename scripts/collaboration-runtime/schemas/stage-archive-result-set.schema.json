{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oes.local/schemas/collaboration-runtime/stage-archive-result-set-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "resultSetFingerprint",
    "stageKey",
    "stageOwnerTaskId",
    "transitionId",
    "stageCleanupAuthorizationFingerprint",
    "inventoryFingerprint",
    "results"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "OES_STAGE_ARCHIVE_RESULT_SET" },
    "resultSetFingerprint": { "$ref": "#/$defs/sha256" },
    "stageKey": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "stageOwnerTaskId": { "type": "string", "minLength": 1 },
    "transitionId": { "type": "string", "minLength": 1 },
    "stageCleanupAuthorizationFingerprint": { "$ref": "#/$defs/sha256" },
    "inventoryFingerprint": { "$ref": "#/$defs/sha256" },
    "results": {
      "type": "array",
      "items": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "role",
        "state",
        "inventoryFingerprint",
        "taskNativeReadbackFingerprint",
        "resultFingerprint"
      ],
      "properties": {
        "taskId": { "type": "string", "minLength": 1 },
        "role": {
          "enum": ["IT", "FEATURE_RI", "FL", "STAGE_DESIGN", "STAGE_RI", "SL"]
        },
        "state": { "enum": ["ARCHIVED", "FAILED"] },
        "inventoryFingerprint": { "$ref": "#/$defs/sha256" },
        "taskNativeReadbackFingerprint": { "$ref": "#/$defs/sha256" },
        "resultFingerprint": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
