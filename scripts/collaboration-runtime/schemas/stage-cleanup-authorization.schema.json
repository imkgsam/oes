{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oes.local/schemas/collaboration-runtime/stage-cleanup-authorization-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "authorizationFingerprint",
    "stageKey",
    "stageOwnerTaskId",
    "transitionId",
    "confirmationFingerprint",
    "terminalFeatures",
    "cleanupOnlyBranch",
    "allowedDeletedFeaturePackets"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "OES_STAGE_CLEANUP_AUTHORIZATION" },
    "authorizationFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stageKey": { "type": "string" },
    "stageOwnerTaskId": { "type": "string" },
    "transitionId": { "type": "string" },
    "confirmationFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "terminalFeatures": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "cleanupOnlyBranch": { "type": "string", "pattern": "^codex/cleanup/" },
    "allowedDeletedFeaturePackets": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^docs/plans/features/.+\\.md$" }
    }
  }
}
