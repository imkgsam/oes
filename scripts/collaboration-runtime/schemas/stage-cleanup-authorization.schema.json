{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oes.local/schemas/collaboration-runtime/stage-cleanup-authorization-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "authorizationFingerprint",
    "status",
    "expectedState",
    "stateVersion",
    "stageKey",
    "stageOwnerTaskId",
    "transitionId",
    "confirmationFingerprint",
    "terminalFeatures",
    "cleanupOnlyBranch",
    "allowedDeletedFeaturePackets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "OES_STAGE_CLEANUP_AUTHORIZATION"
    },
    "authorizationFingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "const": "ISSUED"
    },
    "expectedState": {
      "const": "STAGE_CLEANUP_AUTHORIZED"
    },
    "stateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "stageKey": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "stageOwnerTaskId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/[A-Za-z0-9][A-Za-z0-9_-]*(?:/[A-Za-z0-9][A-Za-z0-9_-]*)+|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"
    },
    "transitionId": {
      "type": "string",
      "minLength": 1
    },
    "confirmationFingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "terminalFeatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/feature"
      }
    },
    "cleanupOnlyBranch": {
      "type": "string",
      "pattern": "^codex/cleanup/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "allowedDeletedFeaturePackets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^docs/plans/features/.+\\.md$"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "expectedSha"],
      "properties": {
        "kind": {
          "enum": ["remote-branch", "local-branch", "worktree", "task-temp"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "expectedSha": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "resourceTopologyVersion": {
          "const": "stable-owner-exclusive-v1"
        }
      },
      "allOf": [
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "kind": {
                    "enum": ["remote-branch", "local-branch"]
                  }
                }
              },
              {
                "not": {
                  "required": ["resourceTopologyVersion"]
                }
              }
            ]
          },
          "then": {
            "properties": {
              "path": {
                "pattern": "^codex/feature/[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "expectedSha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "kind": {
                    "const": "worktree"
                  }
                }
              },
              {
                "not": {
                  "required": ["resourceTopologyVersion"]
                }
              }
            ]
          },
          "then": {
            "properties": {
              "path": {
                "pattern": "^/private/tmp/oes-fl-[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "expectedSha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "kind": {
                    "const": "task-temp"
                  }
                }
              },
              {
                "not": {
                  "required": ["resourceTopologyVersion"]
                }
              }
            ]
          },
          "then": {
            "properties": {
              "path": {
                "pattern": "^/private/tmp/oes-fl-[a-z0-9]+(?:-[a-z0-9]+)*-artifacts$"
              },
              "expectedSha": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "featureKey",
        "ownerTaskId",
        "candidateSha",
        "mergeSha",
        "featurePacket",
        "resources"
      ],
      "properties": {
        "featureKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "ownerTaskId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:/[A-Za-z0-9][A-Za-z0-9_-]*(?:/[A-Za-z0-9][A-Za-z0-9_-]*)+|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"
        },
        "candidateSha": {
          "$ref": "#/$defs/gitSha"
        },
        "mergeSha": {
          "$ref": "#/$defs/gitSha"
        },
        "featurePacket": {
          "type": "string",
          "pattern": "^docs/plans/features/[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"
        },
        "resources": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/resource"
          },
          "allOf": [
            { "contains": { "properties": { "kind": { "const": "remote-branch" } } } },
            { "contains": { "properties": { "kind": { "const": "local-branch" } } } },
            { "contains": { "properties": { "kind": { "const": "worktree" } } } },
            { "contains": { "properties": { "kind": { "const": "task-temp" } } } }
          ]
        },
        "resourceTopologyVersion": {
          "const": "stable-owner-exclusive-v1"
        },
        "ownerResourceBinding": {
          "$ref": "#/$defs/ownerResourceBinding"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["resourceTopologyVersion"]
          },
          "then": {
            "required": ["ownerResourceBinding"],
            "properties": {
              "resources": {
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/resource"
                    },
                    {
                      "required": ["resourceTopologyVersion"]
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["ownerResourceBinding"]
          },
          "then": {
            "required": ["resourceTopologyVersion"]
          }
        },
        {
          "if": {
            "not": {
              "required": ["resourceTopologyVersion"]
            }
          },
          "then": {
            "properties": {
              "resources": {
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/resource"
                    },
                    {
                      "not": {
                        "required": ["resourceTopologyVersion"]
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "ownerResourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "bindingFingerprint",
        "resourceTopologyVersion",
        "ownerTaskId",
        "directParentTaskId",
        "transitionId",
        "repositoryRoot",
        "repositoryRemoteUrl",
        "ownerClone",
        "ownerGitDirectory",
        "ownerRef",
        "artifactRoot",
        "taskTempRoot",
        "featurePacket",
        "featurePacketCheckpointPath",
        "currentEvidenceManifestPath",
        "checkpointBundlePath",
        "gitBundlePath"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "OES_OWNER_RESOURCE_BINDING"
        },
        "bindingFingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "resourceTopologyVersion": {
          "const": "stable-owner-exclusive-v1"
        },
        "ownerTaskId": {
          "type": "string",
          "minLength": 1
        },
        "directParentTaskId": {
          "type": "string",
          "minLength": 1
        },
        "transitionId": {
          "type": "string",
          "minLength": 1
        },
        "repositoryRoot": {
          "type": "string",
          "pattern": "^/"
        },
        "repositoryRemoteUrl": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$"
        },
        "ownerClone": {
          "type": "string",
          "pattern": "^/"
        },
        "ownerGitDirectory": {
          "type": "string",
          "pattern": "^/"
        },
        "ownerRef": {
          "type": "string",
          "pattern": "^refs/heads/"
        },
        "artifactRoot": {
          "type": "string",
          "pattern": "^/"
        },
        "taskTempRoot": {
          "type": "string",
          "pattern": "^/"
        },
        "featurePacket": {
          "type": "string",
          "pattern": "^docs/plans/features/[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"
        },
        "currentEvidenceManifestPath": {
          "type": "string",
          "pattern": "^/"
        },
        "checkpointBundlePath": {
          "type": "string",
          "pattern": "^/"
        },
        "gitBundlePath": {
          "type": "string",
          "pattern": "^/"
        },
        "featurePacketCheckpointPath": {
          "type": "string",
          "pattern": "^/"
        }
      }
    }
  }
}
