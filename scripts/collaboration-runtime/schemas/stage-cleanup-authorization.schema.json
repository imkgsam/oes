{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oes.local/schemas/collaboration-runtime/stage-cleanup-authorization-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "authorizationFingerprint",
    "status",
    "expectedState",
    "stateVersion",
    "stageKey",
    "stageOwnerTaskId",
    "transitionId",
    "confirmationFingerprint",
    "terminalFeatures",
    "cleanupOnlyBranch",
    "allowedDeletedFeaturePackets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "OES_STAGE_CLEANUP_AUTHORIZATION"
    },
    "authorizationFingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "const": "ISSUED"
    },
    "expectedState": {
      "const": "STAGE_CLEANUP_AUTHORIZED"
    },
    "stateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "stageKey": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "stageOwnerTaskId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/[A-Za-z0-9][A-Za-z0-9_-]*(?:/[A-Za-z0-9][A-Za-z0-9_-]*)+$"
    },
    "transitionId": {
      "type": "string",
      "minLength": 1
    },
    "confirmationFingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "terminalFeatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/feature"
      }
    },
    "cleanupOnlyBranch": {
      "type": "string",
      "pattern": "^codex/cleanup/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "allowedDeletedFeaturePackets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^docs/plans/features/.+\\.md$"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "expectedSha"],
      "properties": {
        "kind": {
          "enum": ["remote-branch", "local-branch", "worktree", "task-temp"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "expectedSha": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["remote-branch", "local-branch"]
              }
            }
          },
          "then": {
            "properties": {
              "path": {
                "pattern": "^codex/feature/[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "expectedSha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "worktree"
              }
            }
          },
          "then": {
            "properties": {
              "path": {
                "pattern": "^/private/tmp/oes-fl-[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "expectedSha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "task-temp"
              }
            }
          },
          "then": {
            "properties": {
              "path": {
                "pattern": "^/private/tmp/oes-fl-[a-z0-9]+(?:-[a-z0-9]+)*-artifacts$"
              },
              "expectedSha": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "featureKey",
        "ownerTaskId",
        "candidateSha",
        "mergeSha",
        "featurePacket",
        "resources"
      ],
      "properties": {
        "featureKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "ownerTaskId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/[A-Za-z0-9][A-Za-z0-9_-]*(?:/[A-Za-z0-9][A-Za-z0-9_-]*)+$"
        },
        "candidateSha": {
          "$ref": "#/$defs/gitSha"
        },
        "mergeSha": {
          "$ref": "#/$defs/gitSha"
        },
        "featurePacket": {
          "type": "string",
          "pattern": "^docs/plans/features/[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/resource"
          }
        }
      }
    }
  }
}
