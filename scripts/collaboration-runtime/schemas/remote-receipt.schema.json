{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oes.local/schemas/collaboration-runtime/remote-receipt-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "mutationPerformed",
    "recoveredFromRemoteTruth",
    "branchHead",
    "pullRequestNumber",
    "mergeCommitSha"
  ],
  "properties": {
    "action": { "$ref": "#/$defs/action" },
    "mutationPerformed": { "type": "boolean" },
    "recoveredFromRemoteTruth": { "type": "boolean" },
    "branchHead": { "$ref": "#/$defs/nullableGitSha" },
    "pullRequestNumber": { "type": ["integer", "null"], "minimum": 1 },
    "mergeCommitSha": { "$ref": "#/$defs/nullableGitSha" },
    "mergeGroupBaseSha": { "$ref": "#/$defs/nullableGitSha" },
    "mergeGroupHeadSha": { "$ref": "#/$defs/nullableGitSha" },
    "cleanupResources": { "type": "array", "items": { "$ref": "#/$defs/resource" } }
  },
  "$defs": {
    "action": {
      "enum": ["preflight", "publish-pr", "verify-pr", "merge-pr", "verify-main", "cleanup"]
    },
    "nullableGitSha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "expectedSha"],
      "properties": {
        "kind": { "enum": ["remote-branch", "local-branch", "worktree", "feature-packet"] },
        "path": { "type": "string", "minLength": 1 },
        "expectedSha": { "$ref": "#/$defs/nullableGitSha" }
      }
    }
  }
}
