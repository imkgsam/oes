{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oes.local/schemas/collaboration-runtime/stage-child-cleanup-authorization-v1.json",
  "title": "OES Stage child cleanup authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "authorizationFingerprint",
    "status",
    "rootAuthorization",
    "expectedState",
    "stateVersion",
    "stageKey",
    "stageOwnerTaskId",
    "ownerTaskId",
    "transitionId",
    "confirmationFingerprint",
    "resources",
    "postcondition"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "OES_STAGE_CHILD_CLEANUP_AUTHORIZATION"
    },
    "authorizationFingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "const": "ISSUED"
    },
    "rootAuthorization": {
      "$ref": "#/$defs/reference"
    },
    "expectedState": {
      "const": "STAGE_CLEANUP_AUTHORIZED"
    },
    "stateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "stageKey": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "stageOwnerTaskId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/[A-Za-z0-9][A-Za-z0-9_-]*(?:/[A-Za-z0-9][A-Za-z0-9_-]*)+|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"
    },
    "ownerTaskId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/[A-Za-z0-9][A-Za-z0-9_-]*(?:/[A-Za-z0-9][A-Za-z0-9_-]*)+|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"
    },
    "transitionId": {
      "type": "string",
      "minLength": 1
    },
    "confirmationFingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "resources": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/resource"
      },
      "allOf": [
        { "contains": { "properties": { "kind": { "const": "remote-branch" } } } },
        { "contains": { "properties": { "kind": { "const": "local-branch" } } } },
        { "contains": { "properties": { "kind": { "const": "worktree" } } } },
        { "contains": { "properties": { "kind": { "const": "task-temp" } } } }
      ]
    },
    "postcondition": {
      "const": "CHILD_SELF_CLEANUP"
    },
    "resourceTopologyVersion": {
      "const": "stable-owner-exclusive-v1"
    },
    "ownerResourceBinding": {
      "$ref": "#/$defs/ownerResourceBinding"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "fingerprint"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "expectedSha"],
      "properties": {
        "kind": {
          "enum": ["remote-branch", "local-branch", "worktree", "task-temp"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "expectedSha": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "resourceTopologyVersion": {
          "const": "stable-owner-exclusive-v1"
        }
      },
      "allOf": [
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "kind": {
                    "enum": ["remote-branch", "local-branch"]
                  }
                }
              },
              {
                "not": {
                  "required": ["resourceTopologyVersion"]
                }
              }
            ]
          },
          "then": {
            "properties": {
              "path": {
                "pattern": "^codex/feature/[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "expectedSha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "kind": {
                    "const": "worktree"
                  }
                }
              },
              {
                "not": {
                  "required": ["resourceTopologyVersion"]
                }
              }
            ]
          },
          "then": {
            "properties": {
              "path": {
                "pattern": "^/private/tmp/oes-fl-[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "expectedSha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "kind": {
                    "const": "task-temp"
                  }
                }
              },
              {
                "not": {
                  "required": ["resourceTopologyVersion"]
                }
              }
            ]
          },
          "then": {
            "properties": {
              "path": {
                "pattern": "^/private/tmp/oes-fl-[a-z0-9]+(?:-[a-z0-9]+)*-artifacts$"
              },
              "expectedSha": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "kind": {
                    "const": "task-temp"
                  }
                }
              },
              {
                "required": ["resourceTopologyVersion"]
              }
            ]
          },
          "then": {
            "properties": {
              "path": {
                "$ref": "#/$defs/stableTaskTempRoot"
              },
              "expectedSha": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "ownerResourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "bindingFingerprint",
        "resourceTopologyVersion",
        "ownerTaskId",
        "directParentTaskId",
        "transitionId",
        "repositoryRoot",
        "repositoryRemoteUrl",
        "ownerClone",
        "ownerGitDirectory",
        "ownerRef",
        "artifactRoot",
        "taskTempRoot",
        "featurePacket",
        "featurePacketCheckpointPath",
        "currentEvidenceManifestPath",
        "checkpointBundlePath",
        "gitBundlePath"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "OES_OWNER_RESOURCE_BINDING"
        },
        "bindingFingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "resourceTopologyVersion": {
          "const": "stable-owner-exclusive-v1"
        },
        "ownerTaskId": {
          "type": "string",
          "minLength": 1
        },
        "directParentTaskId": {
          "type": "string",
          "minLength": 1
        },
        "transitionId": {
          "type": "string",
          "minLength": 1
        },
        "repositoryRoot": {
          "type": "string",
          "pattern": "^/"
        },
        "repositoryRemoteUrl": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$"
        },
        "ownerClone": {
          "type": "string",
          "pattern": "^/"
        },
        "ownerGitDirectory": {
          "type": "string",
          "pattern": "^/"
        },
        "ownerRef": {
          "type": "string",
          "pattern": "^refs/heads/"
        },
        "artifactRoot": {
          "type": "string",
          "pattern": "^/"
        },
        "taskTempRoot": {
          "$ref": "#/$defs/stableTaskTempRoot"
        },
        "featurePacket": {
          "type": "string",
          "pattern": "^docs/plans/features/[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"
        },
        "currentEvidenceManifestPath": {
          "type": "string",
          "pattern": "^/"
        },
        "checkpointBundlePath": {
          "type": "string",
          "pattern": "^/"
        },
        "gitBundlePath": {
          "type": "string",
          "pattern": "^/"
        },
        "featurePacketCheckpointPath": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "stableTaskTempRoot": {
      "type": "string",
      "pattern": "^/(?:tmp|private/tmp|private/var/folders/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/T)/oes-[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["resourceTopologyVersion"]
      },
      "then": {
        "required": ["ownerResourceBinding"],
        "properties": {
          "resources": {
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/resource"
                },
                {
                  "required": ["resourceTopologyVersion"]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["ownerResourceBinding"]
      },
      "then": {
        "required": ["resourceTopologyVersion"]
      }
    },
    {
      "if": {
        "not": {
          "required": ["resourceTopologyVersion"]
        }
      },
      "then": {
        "properties": {
          "resources": {
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/resource"
                },
                {
                  "not": {
                    "required": ["resourceTopologyVersion"]
                  }
                }
              ]
            }
          }
        }
      }
    }
  ]
}
