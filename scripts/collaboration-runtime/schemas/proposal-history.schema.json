{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oes.local/schemas/collaboration-runtime/proposal-history-v1.json",
  "title": "OES UD Proposal Native History V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["history", "audience"],
  "properties": {
    "audience": {
      "enum": ["EXACT_UD", "PROJECT_ROLE", "BOUNDED_HELPER"]
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": {
          "enum": [
            "PROPOSAL_TRANSPORT",
            "PROPOSAL_RECEIPT",
            "PROPOSAL_TERMINAL_RESULT",
            "PROPOSAL_TERMINAL_DELIVERY"
          ]
        },
        "envelope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "kind",
            "proposalId",
            "proposalFingerprint",
            "scope",
            "source",
            "returnTaskId",
            "supersedesProposalId"
          ],
          "properties": {
            "schemaVersion": { "const": 1 },
            "kind": { "const": "OES_UD_PROPOSAL" },
            "proposalId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
            "proposalFingerprint": { "$ref": "#/$defs/fingerprint" },
            "scope": { "type": "string", "minLength": 1 },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "taskId"],
              "properties": {
                "role": { "type": "string", "minLength": 1 },
                "taskId": { "type": "string", "minLength": 1 }
              }
            },
            "returnTaskId": { "type": "string", "minLength": 1 },
            "supersedesProposalId": { "type": ["string", "null"] }
          }
        },
        "proposalId": { "type": "string", "minLength": 1 },
        "proposalFingerprint": { "$ref": "#/$defs/fingerprint" },
        "sourceTaskId": { "type": "string", "minLength": 1 },
        "returnTaskId": { "type": "string", "minLength": 1 },
        "receipt": {
          "enum": [
            "TRANSPORT_ACCEPTED",
            "UD_ADMITTED",
            "PROCESSING",
            "SUPERSEDED",
            "CANCELLED",
            "TERMINAL"
          ]
        },
        "terminalStatus": { "type": ["string", "null"] },
        "terminalResultDeliveryKey": { "type": ["string", "null"] },
        "safeBoundary": { "type": "boolean" },
        "result": { "$ref": "#/$defs/terminalResult" },
        "delivery": { "$ref": "#/$defs/terminalDelivery" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "PROPOSAL_TRANSPORT" } } },
          "then": { "required": ["envelope"] }
        },
        {
          "if": { "properties": { "kind": { "const": "PROPOSAL_RECEIPT" } } },
          "then": {
            "required": [
              "proposalId",
              "proposalFingerprint",
              "sourceTaskId",
              "returnTaskId",
              "receipt",
              "terminalStatus",
              "terminalResultDeliveryKey",
              "safeBoundary"
            ]
          }
        },
        {
          "if": { "properties": { "kind": { "const": "PROPOSAL_TERMINAL_RESULT" } } },
          "then": { "required": ["result"] }
        },
        {
          "if": { "properties": { "kind": { "const": "PROPOSAL_TERMINAL_DELIVERY" } } },
          "then": { "required": ["delivery"] }
        }
      ]
    },
    "terminalResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "resultFingerprint",
        "proposalId",
        "proposalFingerprint",
        "returnTaskId",
        "terminalStatus",
        "payload",
        "payloadFingerprint"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "OES_UD_PROPOSAL_TERMINAL_RESULT" },
        "resultFingerprint": { "$ref": "#/$defs/fingerprint" },
        "proposalId": { "type": "string", "minLength": 1 },
        "proposalFingerprint": { "$ref": "#/$defs/fingerprint" },
        "returnTaskId": { "type": "string", "minLength": 1 },
        "terminalStatus": { "type": "string", "minLength": 1 },
        "payload": {},
        "payloadFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "terminalDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "deliveryFingerprint",
        "proposalId",
        "proposalFingerprint",
        "returnTaskId",
        "terminalStatus",
        "resultFingerprint",
        "payloadFingerprint",
        "outcome"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "OES_UD_PROPOSAL_TERMINAL_DELIVERY" },
        "deliveryFingerprint": { "$ref": "#/$defs/fingerprint" },
        "proposalId": { "type": "string", "minLength": 1 },
        "proposalFingerprint": { "$ref": "#/$defs/fingerprint" },
        "returnTaskId": { "type": "string", "minLength": 1 },
        "terminalStatus": { "type": "string", "minLength": 1 },
        "resultFingerprint": { "$ref": "#/$defs/fingerprint" },
        "payloadFingerprint": { "$ref": "#/$defs/fingerprint" },
        "outcome": { "const": "DELIVERED" }
      }
    }
  }
}
