{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oes.local/schemas/collaboration-runtime/coordination-cleanup-current-authorization-v2.json",
  "title": "OES V2 current coordination cleanup CAS authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "recordFingerprint",
    "status",
    "purpose",
    "rootAuthorization",
    "childAuthorization",
    "coordinationKey",
    "coordinationOwnerTaskId",
    "ownerTaskId",
    "expectedState",
    "stateVersion",
    "transitionId",
    "confirmationFingerprint",
    "postcondition"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "kind": {
      "const": "OES_COORDINATION_CLEANUP_CURRENT_AUTHORIZATION"
    },
    "recordFingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "enum": ["ACTIVE", "INVALIDATED", "COMPLETED"]
    },
    "purpose": {
      "enum": ["CHILD_SELF_CLEANUP", "COORDINATION_CLEANUP_VERIFY"]
    },
    "rootAuthorization": {
      "$ref": "#/$defs/reference"
    },
    "childAuthorization": {
      "$ref": "#/$defs/nullableReference"
    },
    "coordinationKey": {
      "type": "string",
      "minLength": 1
    },
    "coordinationOwnerTaskId": {
      "type": "string",
      "minLength": 1
    },
    "ownerTaskId": {
      "type": "string",
      "minLength": 1
    },
    "expectedState": {
      "const": "COORDINATION_CLEANUP_AUTHORIZED"
    },
    "stateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "transitionId": {
      "type": "string",
      "minLength": 1
    },
    "confirmationFingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "postcondition": {
      "const": "CURRENT_COORDINATION_CLEANUP"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "fingerprint"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "nullableReference": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "sha256", "fingerprint"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "fingerprint": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
