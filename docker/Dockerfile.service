# Builds one OES backend package while preserving workspace and generated-client links.
FROM bufbuild/buf:1.61.0@sha256:3b7fb27f8ff153037b3f781924c6aa1327352f14ee547cf45fd75f6d994fe0eb AS buf

FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS builder
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /app
COPY --from=buf /usr/local/bin/buf /usr/local/bin/buf
COPY . .
RUN pnpm install --frozen-lockfile
ARG PACKAGE_NAME
RUN test -n "$PACKAGE_NAME" \
  && pnpm proto:gen \
  && pnpm prisma:generate:all \
  && pnpm common:build \
  && pnpm --filter "$PACKAGE_NAME" build

FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS runner
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /app
ENV NODE_ENV=development
ARG SERVICE_PATH
ENV OES_SERVICE_PATH=$SERVICE_PATH
COPY --from=builder /app /app
CMD ["sh", "-ec", "exec node \"$OES_SERVICE_PATH/dist/main.js\""]
