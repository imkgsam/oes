{
  "manifest_version": 3,
  "name": "OES BE",
  "description": "OES browser extension.",
  "version": "0.1.0",
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "index.html",
    "default_title": "OES BE"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "open-crm-workspace": {
      "description": "Open OES CRM workspace",
      "suggested_key": {
        "default": "Alt+Shift+O"
      }
    }
  },
  "permissions": ["storage", "activeTab", "scripting", "sidePanel", "contextMenus", "tabs"],
  "side_panel": {
    "default_path": "side-panel.html"
  },
  "host_permissions": ["http://*/*", "https://*/*", "http://localhost:9101/*", "https://*.oes.local/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
