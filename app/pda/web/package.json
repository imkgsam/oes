{
  "name": "@oes/pda-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run '.unit.spec.'",
    "test:component": "vitest run '.component.spec.'",
    "test:contract": "vitest run '.contract.spec.'",
    "test:integration": "vitest run '.integration.spec.' --passWithNoTests"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.5",
    "@vueuse/core": "^14.2.1",
    "pinia": "^3.0.4",
    "vant": "^4.9.21",
    "vue": "^3.5.30",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.8.4",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^3.0.0"
  }
}
