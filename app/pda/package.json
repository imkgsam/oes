{
  "name": "oes-pda-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "pnpm --filter @oes/pda-web build",
    "build:android": "scripts/android-gradle.sh :app:assembleDebug",
    "build:apk": "pnpm build:web && pnpm build:android",
    "doctor:android": "scripts/android-doctor.sh",
    "dev:web": "pnpm --filter @oes/pda-web dev",
    "gradle:android": "scripts/android-gradle.sh",
    "install:android": "scripts/android-gradle.sh :app:installDebug",
    "typecheck:web": "pnpm --filter @oes/pda-web typecheck",
    "check:static": "node scripts/check-static.mjs",
    "test": "pnpm test:unit && pnpm test:component && pnpm test:contract && pnpm test:integration",
    "test:unit": "pnpm --filter @oes/pda-web test:unit && scripts/android-gradle.sh :app:testDebugUnitTest",
    "test:component": "pnpm --filter @oes/pda-web test:component",
    "test:contract": "pnpm --filter @oes/pda-web test:contract",
    "test:integration": "pnpm --filter @oes/pda-web test:integration"
  },
  "packageManager": "pnpm@10.32.1"
}
