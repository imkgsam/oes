# Sanitized local-worktree inputs. `pnpm env:bootstrap` expands `auto` into a
# deterministic worktree key and writes ignored `.env` files without touching
# an existing user-managed environment.
OES_ENVIRONMENT=development
OES_TASK_KEY=auto
OES_POSTGRES_HOST=127.0.0.1
OES_POSTGRES_PORT=5432
OES_POSTGRES_USER=oes_local
OES_POSTGRES_PASSWORD=oes_local_only
OES_DATABASE_PREFIX=oes
