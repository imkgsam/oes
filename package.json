{
  "name": "oes",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "src/services/*",
    "src/services/auxiliary/*",
    "src/services/business/*",
    "src/services/system/*",
    "src/common"
  ],
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "pnpm -r run lint",
    "prisma:generate:all": "pnpm -r run prisma:generate",
    "prisma:push:all": "pnpm -r run prisma:push",
    "proto:gen": "buf generate --template src/common/src/contracts/buf.gen.yaml src/common/src/contracts",
    "proto:regen": "rimraf src/common/src/generated && pnpm run proto:gen",
    "proto:lint": "buf lint src/common/src/contracts",
    "proto:breaking": "buf breaking src/common/src/contracts --against .git#subdir=src/common/src/contracts",
    "proto:format": "buf format -w src/common/src/contracts",
    "clear:nm": "rimraf node_modules",
    "clear:nm:all": "pnpm -r run clear:nm && pnpm clear:nm",
    "clear:build": "rimraf dist && rimraf tsconfig.tsbuildinfo && rimraf pnpm-lock.yaml",
    "clear:build:all": "pnpm -r run clear:build && pnpm clear:build",
    "clear": "npm run clear:build:all && npm run clear:nm:all",
    "docker:infra:up": "docker compose -f docker-compose.infra.yml up -d",
    "docker:infra:down": "docker compose -f docker-compose.infra.yml down",
    "common:build": "pnpm --filter @oes/common build",
    "common:dev": "pnpm --filter @oes/common dev",
    "pms": "pnpm --filter permission-service dev",
    "ids": "pnpm --filter identity-service dev",
    "ats": "pnpm --filter auth-service dev",
    "pts": "pnpm --filter party-service dev",
    "bff": "pnpm --filter api-gateway dev",
    "dev": "pnpm common:build && concurrently -k -n common,pms,ids,ats,bff \"pnpm common:dev\" \"pnpm pms\" \"pnpm ids\" \"pnpm ats\" \"pnpm bff\"",
    "seed:tenant-web-auth": "node scripts/local/seed-tenant-web-auth-test-data.mjs",
    "web": "pnpm --dir app/web --filter @oes/tenant-web dev"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.1.3",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/microservices": "^11.1.3",
    "@nestjs/platform-express": "^11.0.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.69.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.211.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.211.0",
    "@opentelemetry/resources": "^2.5.0",
    "@opentelemetry/sdk-metrics": "^2.5.0",
    "@opentelemetry/sdk-node": "^0.211.0",
    "axios": "^1.11.0",
    "axios-retry": "^4.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^5.6.1",
    "lodash": "^4.17.21",
    "nacos": "^2.6.1",
    "otplib": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@prisma/client": "6.4.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.2.1",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "grpc-tools": "^1.13.1",
    "grpc_tools_node_protoc_ts": "^5.3.3",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "6.4.1",
    "protobufjs": "^8.0.0",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.11.1",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
